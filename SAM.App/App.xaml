<Application
    x:Class="SAM.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Skeleton placeholder base colour and the moving highlight. -->
                    <Color x:Key="SkeletonBaseColor">#1FFFFFFF</Color>
                    <Color x:Key="SkeletonHighlightColor">#3DFFFFFF</Color>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#19000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SkeletonBaseColor">#14000000</Color>
                    <Color x:Key="SkeletonHighlightColor">#29000000</Color>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#0F000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Rarity tiers, used for the achievement rarity badge. -->
            <SolidColorBrush x:Key="RarityCommonBrush" Color="#8A9199" />
            <SolidColorBrush x:Key="RarityUncommonBrush" Color="#4CAF50" />
            <SolidColorBrush x:Key="RarityRareBrush" Color="#2196F3" />
            <SolidColorBrush x:Key="RarityEpicBrush" Color="#9C27B0" />
            <SolidColorBrush x:Key="RarityLegendaryBrush" Color="#FF9800" />

            <x:Double x:Key="CardCornerRadiusValue">8</x:Double>
            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
