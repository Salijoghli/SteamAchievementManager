<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SAM</AssemblyName>
    <RootNamespace>SAM.App</RootNamespace>
    <AssemblyTitle>Steam Achievement Manager</AssemblyTitle>
    <Description>Manage achievements and statistics for your Steam games.</Description>
    <Version>8.2.1</Version>
    <AssemblyVersion>8.2.1.0</AssemblyVersion>
    <FileVersion>8.2.1.0</FileVersion>
    <!-- Show e.g. "8.1.1" in the file properties, not "8.1.1+<commit hash>". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepositoryUrl>https://github.com/Salijoghli/SteamAchievementManager/</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Bundle .NET too, so SAM.exe runs on any Windows 10/11 PC without installing anything. -->
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SAM.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- English UI text, also embedded so Strings works where the resource system isn't available (e.g. tests). -->
    <EmbeddedResource Include="Strings\en-US\Resources.resw" LogicalName="SAM.App.Strings.en-US.Resources.resw" />
    <!-- The app icon, written out at run time when there's no Assets folder (single-file SAM.exe). -->
    <EmbeddedResource Include="Assets\SAM.ico" LogicalName="SAM.App.Assets.SAM.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <!-- WinUI 2.3.9 asks for InteractiveExperiences >= 2.1.8, which was never published. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SAM.API\SAM.API.csproj" />
  </ItemGroup>
</Project>
