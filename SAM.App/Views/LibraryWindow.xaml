<Window
    x:Class="SAM.App.Views.LibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SAM.App.Controls"
    xmlns:library="using:SAM.App.Views.Library"
    xmlns:vm="using:SAM.App.ViewModels">

    <Grid
        x:Name="Root"
        RequestedTheme="{x:Bind ViewModel.RequestedTheme, Mode=OneWay}"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearchAccelerator" />
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnQuickSwitcherAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <!-- Cards draw their own hover/press visuals; keep the container's overlay out of the way. -->
            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />

            <!-- Cards fill their slot; slot size is computed from the window width in code-behind. -->
            <Style x:Key="CardContainerStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                <Setter Property="Margin" Value="6" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!-- List view rows: the row control draws its own columns. -->
            <Style x:Key="RowContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Margin" Value="0,1,0,1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!-- Clickable list view column headers. -->
            <Style x:Key="ColumnHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="28" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Header, notices and grid share one centred column on very wide screens. -->
            <x:Double x:Key="ContentMaxWidth">2400</x:Double>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="SummaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (drag region). -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/SAM.ico" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock
                x:Uid="Library_AppTitle"
                Grid.Column="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Page switcher: the library and the pages next to it. -->
        <!-- Tabs, with app-wide Settings at the right so it's reachable from every tab. -->
        <Grid Grid.Row="1" Margin="16,0,24,4" MaxWidth="{StaticResource ContentMaxWidth}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <SelectorBar
            x:Name="PageSelector"
            HorizontalAlignment="Stretch"
            SelectionChanged="OnPageSelectionChanged">
            <SelectorBarItem x:Name="LibraryPageItem" x:Uid="Library_PageLibrary" Tag="library" IsSelected="True">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE8F1;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="Library_PageStats" Tag="stats">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE9D2;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="Library_PageActivity" Tag="activity">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE7C1;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="Library_PageHistory" Tag="history">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Uid="Library_PageAutopilot" Tag="autopilot">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE945;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource IconButtonStyle}"
                x:Uid="Library_SettingsButton"
                Click="OnSettingsClick">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Non-library pages (Stats, Activity, History) replace the library rows below. -->
        <ContentControl
            x:Name="PageHost"
            Grid.Row="2"
            Grid.RowSpan="3"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Visibility="Collapsed" />

        <!-- Header: search, actions, summary, sort and filters. -->
        <Grid x:Name="LibraryHeader" Grid.Row="2" Padding="24,4,24,8" RowSpacing="12" MaxWidth="{StaticResource ContentMaxWidth}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                One row: search, then three menus (what to show, how to sort, filters) and the more
                button for the view mode, refresh and the rarely used actions.
            -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    x:Uid="Library_SearchBox"
                    MaxWidth="720"
                    HorizontalAlignment="Stretch"
                    QueryIcon="Find"
                    UpdateTextOnSelect="False"
                    Text="{x:Bind ViewModel.SearchText, Mode=OneWay}"
                    TextChanged="OnSearchTextChanged"
                    QuerySubmitted="OnSearchQuerySubmitted"
                    PreviewKeyDown="OnSearchPreviewKeyDown" />

                <!-- Show: collections and smart lists in one menu. -->
                <DropDownButton x:Uid="Library_ShowPicker" Grid.Column="1" Height="34">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ShowLabel, Mode=OneWay}"
                            MaxWidth="220"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ShowMenu" Placement="BottomEdgeAlignedLeft" Opening="OnShowMenuOpening">
                            <MenuFlyoutItem x:Uid="Library_AllGamesItem" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Sort: order, direction and "favorites first" in one menu. -->
                <DropDownButton x:Uid="Library_SortPicker" Grid.Column="2" Height="34">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}" />
                        <FontIcon
                            Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedLeft" Opening="OnSortMenuOpening">
                            <MenuFlyoutItem x:Uid="Library_AllGamesItem" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                    <DropDownButton x:Uid="Library_FiltersButton" Grid.Column="3" Height="34">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71C;" FontSize="14" />
                            <TextBlock x:Uid="Library_FiltersLabel" />
                            <InfoBadge
                                Value="{x:Bind ViewModel.ActiveFilterBadge, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="Library_FilterShow" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <CheckBox x:Uid="Library_FilterGames" IsChecked="{x:Bind ViewModel.ShowGames, Mode=TwoWay}" />
                                        <CheckBox x:Uid="Library_FilterDemos" IsChecked="{x:Bind ViewModel.ShowDemos, Mode=TwoWay}" />
                                        <CheckBox x:Uid="Library_FilterMods" IsChecked="{x:Bind ViewModel.ShowMods, Mode=TwoWay}" />
                                        <CheckBox x:Uid="Library_FilterJunk" IsChecked="{x:Bind ViewModel.ShowJunk, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <ToggleSwitch x:Uid="Library_FilterFavoritesOnly" IsOn="{x:Bind ViewModel.FavoritesOnly, Mode=TwoWay}" />
                                        <ToggleSwitch x:Uid="Library_FilterShowHidden" IsOn="{x:Bind ViewModel.ShowHidden, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <ComboBox
                                            x:Uid="Library_FilterCompletion"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}"
                                            SelectedIndex="{x:Bind ViewModel.CompletionFilterIndex, Mode=TwoWay}">
                                            <ComboBoxItem x:Uid="Library_CompletionAll" />
                                            <ComboBoxItem x:Uid="Library_CompletionHasAchievements" />
                                            <ComboBoxItem x:Uid="Library_CompletionNotStarted" />
                                            <ComboBoxItem x:Uid="Library_CompletionInProgress" />
                                            <ComboBoxItem x:Uid="Library_CompletionPerfect" />
                                        </ComboBox>
                                        <TextBlock
                                            x:Uid="Library_SmartListIgnoresFilter"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Visibility="{x:Bind ViewModel.IsSmartListActive, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <ComboBox
                                            x:Uid="Library_FilterLastPlayed"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="{x:Bind ViewModel.LastPlayedFilterIndex, Mode=TwoWay}">
                                            <ComboBoxItem x:Uid="Library_LastPlayedAny" />
                                            <ComboBoxItem x:Uid="Library_LastPlayedToday" />
                                            <ComboBoxItem x:Uid="Library_LastPlayedPast7Days" />
                                            <ComboBoxItem x:Uid="Library_LastPlayedPast30Days" />
                                            <ComboBoxItem x:Uid="Library_LastPlayedThisYear" />
                                            <ComboBoxItem x:Uid="Library_LastPlayedNever" />
                                            <ComboBoxItem x:Uid="Library_LastPlayedCustom" />
                                        </ComboBox>
                                        <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsCustomRange, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CalendarDatePicker
                                                x:Uid="Library_FilterFrom"
                                                HorizontalAlignment="Stretch"
                                                Date="{x:Bind ViewModel.CustomFrom, Mode=TwoWay}" />
                                            <CalendarDatePicker
                                                x:Uid="Library_FilterTo"
                                                Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                Date="{x:Bind ViewModel.CustomTo, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                    <Button
                                        x:Uid="Library_ResetFilters"
                                        HorizontalAlignment="Right"
                                        Command="{x:Bind ViewModel.ResetFiltersCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                <Button
                    Grid.Column="4"
                    Style="{StaticResource IconButtonStyle}"
                    x:Uid="Library_MoreOptions">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="GridModeItem" x:Uid="Library_ViewGridItem" GroupName="LibraryViewMode" Click="OnGridModeClick">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF0E2;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="ListModeItem" x:Uid="Library_ViewListItem" GroupName="LibraryViewMode" Click="OnListModeClick">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8FD;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Library_RefreshItem" Command="{x:Bind ViewModel.RefreshCommand}" KeyboardAcceleratorTextOverride="F5">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Library_ExportLibraryItem" Click="OnExportLibraryClick" IsEnabled="{x:Bind vm:LibraryFormat.Not(ViewModel.IsExporting), Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEDE1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="Library_ExportAchievementsItem" Click="OnExportAchievementsClick" IsEnabled="{x:Bind vm:LibraryFormat.Not(ViewModel.IsExporting), Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEDE1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="Library_LoadMissingItem" Click="OnLoadMissingClick" IsEnabled="{x:Bind vm:LibraryFormat.Not(ViewModel.IsFetchingAll), Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE896;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Summary only. -->
            <Grid Grid.Row="1">
                <!-- Summary. -->
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center">
                        <controls:Skeleton
                            Width="90"
                            Height="14"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind vm:LibraryFormat.CollapsedIf(ViewModel.IsLoading), Mode=OneWay}" />
                    </Grid>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="16"
                        Visibility="{x:Bind vm:LibraryFormat.CollapsedIf(ViewModel.IsSummaryReady), Mode=OneWay}">
                        <controls:Skeleton Width="90" Height="14" />
                        <controls:Skeleton Width="70" Height="14" />
                        <controls:Skeleton Width="90" Height="14" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.IsSummaryReady, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="{x:Bind ViewModel.CompletionDetail, Mode=OneWay}">
                            <FontIcon Glyph="&#xE9D5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CompletionText, Mode=OneWay}" Style="{StaticResource SummaryTextStyle}" />
                            <!-- "· 5 not loaded": games whose achievement data Steam hasn't downloaded. -->
                            <TextBlock
                                x:Uid="Library_NotLoadedHint"
                                Text="{x:Bind ViewModel.MissingAchievementDataText, Mode=OneWay}"
                                Style="{StaticResource SummaryTextStyle}"
                                Visibility="{x:Bind ViewModel.HasMissingAchievementData, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel x:Uid="Library_PerfectSummary" Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7C1;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PerfectText, Mode=OneWay}" Style="{StaticResource SummaryTextStyle}" />
                        </StackPanel>
                        <StackPanel x:Uid="Library_PlaytimeSummary" Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalPlaytimeText, Mode=OneWay}" Style="{StaticResource SummaryTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <ProgressRing
                        x:Uid="Library_RefreshingRing"
                        Width="16"
                        Height="16"
                        IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Notices. -->
        <StackPanel x:Name="LibraryNotices" Grid.Row="3" Padding="24,0,24,0" Spacing="8" MaxWidth="{StaticResource ContentMaxWidth}">
            <ProgressBar
                IsIndeterminate="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                Opacity="{x:Bind vm:LibraryFormat.OpacityIf(ViewModel.IsRefreshing), Mode=OneWay}"
                x:Uid="Library_RefreshingBar" />
            <InfoBar
                x:Uid="Library_LoadErrorBar"
                Message="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                Severity="Error"
                IsOpen="{x:Bind ViewModel.IsLoadErrorOpen, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsLoadErrorOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Uid="Library_RetryButton" Command="{x:Bind ViewModel.RefreshCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Uid="Library_RefreshWarningBar"
                Message="{x:Bind ViewModel.RefreshWarning, Mode=OneWay}"
                Severity="Warning"
                IsOpen="{x:Bind ViewModel.IsRefreshWarningOpen, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsRefreshWarningOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Uid="Library_RetryButton" Command="{x:Bind ViewModel.RefreshCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                Message="{x:Bind ViewModel.AccountNoticeMessage, Mode=OneWay}"
                Severity="Informational"
                IsOpen="{x:Bind ViewModel.IsAccountNoticeOpen, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsAccountNoticeOpen, Mode=OneWay}" />
            <InfoBar
                Title="{x:Bind ViewModel.UpdateTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}"
                Severity="Informational"
                IsOpen="{x:Bind ViewModel.IsUpdateOpen, Mode=TwoWay}"
                IsClosable="{x:Bind ViewModel.IsUpdateIdle, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsUpdateOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Content="{x:Bind ViewModel.UpdateActionText, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.DownloadUpdateCommand}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <StackPanel Margin="0,0,0,12" Spacing="8">
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsUpdating, Mode=OneWay}" />
                        <Button x:Uid="Library_UpdateSkip" Visibility="{x:Bind ViewModel.IsUpdateIdle, Mode=OneWay}" Command="{x:Bind ViewModel.SkipUpdateCommand}" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
            <InfoBar
                x:Uid="Library_ExportingBar"
                Message="{x:Bind ViewModel.ExportProgressText, Mode=OneWay}"
                Severity="Informational"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsExporting, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay}">
                <InfoBar.Content>
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsExporting, Mode=OneWay}" Margin="0,0,0,12" />
                </InfoBar.Content>
            </InfoBar>
            <InfoBar
                x:Uid="Library_LoadMissingBar"
                Message="{x:Bind ViewModel.FetchAllProgressText, Mode=OneWay}"
                Severity="Informational"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsFetchingAll, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsFetchingAll, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Uid="Library_LoadMissingCancel" Command="{x:Bind ViewModel.CancelFetchAllCommand}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsFetchingAll, Mode=OneWay}" Margin="0,0,0,12" />
                </InfoBar.Content>
            </InfoBar>
            <InfoBar
                x:Uid="Library_ExportDoneBar"
                Message="{x:Bind ViewModel.ExportDoneMessage, Mode=OneWay}"
                Severity="Success"
                IsOpen="{x:Bind ViewModel.IsExportDoneOpen, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsExportDoneOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Uid="Library_OpenExportedFile" Command="{x:Bind ViewModel.OpenExportedFileCommand}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <Button x:Uid="Library_OpenExportedFolder" Margin="0,0,0,12" Command="{x:Bind ViewModel.OpenExportedFolderCommand}" />
                </InfoBar.Content>
            </InfoBar>
            <InfoBar
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsNoticeOpen, Mode=OneWay}" />
        </StackPanel>

        <!-- Content. -->
        <Grid x:Name="LibraryContent" Grid.Row="4" MaxWidth="{StaticResource ContentMaxWidth}" SizeChanged="OnContentSizeChanged">
            <!-- Loading: skeleton cards shaped like real ones. -->
            <GridView
                x:Name="SkeletonGrid"
                ItemsSource="{x:Bind SkeletonItems}"
                Padding="18,8,18,18"
                SelectionMode="None"
                IsHitTestVisible="False"
                IsTabStop="False"
                ItemContainerStyle="{StaticResource CardContainerStyle}"
                Visibility="{x:Bind ViewModel.IsGridSkeletonShown, Mode=OneWay}"
                x:Uid="Library_LoadingGames">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" Loaded="OnCardPanelLoaded" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="x:Int32">
                        <Border
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:Skeleton CornerRadius="7,7,0,0" />
                                <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="6">
                                    <controls:Skeleton Width="170" Height="16" HorizontalAlignment="Left" />
                                    <Grid Height="34">
                                        <StackPanel Spacing="6" VerticalAlignment="Center">
                                            <controls:Skeleton Height="4" CornerRadius="2" />
                                            <controls:Skeleton Width="110" Height="12" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Grid>
                                    <controls:Skeleton Width="140" Height="12" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <GridView
                x:Name="GamesGrid"
                ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                Padding="18,8,18,18"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnGameClick"
                ContainerContentChanging="OnContainerContentChanging"
                ItemContainerStyle="{StaticResource CardContainerStyle}"
                Visibility="{x:Bind ViewModel.IsGridViewShown, Mode=OneWay}"
                x:Uid="Library_GamesGrid">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" Loaded="OnCardPanelLoaded" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameCardViewModel">
                        <library:GameCard Card="{x:Bind}" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- List view: a column header row (click to sort) above a virtualized list. -->
            <Grid Visibility="{x:Bind ViewModel.IsListView, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column widths must match GameListRow. -->
                <Grid
                    Margin="18,8,18,0"
                    Padding="12,0,12,0"
                    Height="32"
                    ColumnSpacing="12"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Tag="name" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnColumnHeaderClick" IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Uid="Library_ColumnName" />
                            <FontIcon FontSize="10" Glyph="{x:Bind vm:LibraryFormat.SortGlyph(ViewModel.ActiveSortColumn, ViewModel.SortDescending, 'name'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Tag="progress" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnColumnHeaderClick" IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Uid="Library_ColumnProgress" />
                            <FontIcon FontSize="10" Glyph="{x:Bind vm:LibraryFormat.SortGlyph(ViewModel.ActiveSortColumn, ViewModel.SortDescending, 'progress'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Tag="progress" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnColumnHeaderClick" IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}">
                        <TextBlock Text="%" />
                    </Button>
                    <Button Grid.Column="4" Tag="playtime" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnColumnHeaderClick" IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Uid="Library_ColumnPlaytime" />
                            <FontIcon FontSize="10" Glyph="{x:Bind vm:LibraryFormat.SortGlyph(ViewModel.ActiveSortColumn, ViewModel.SortDescending, 'playtime'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5" Tag="lastplayed" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnColumnHeaderClick" IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Uid="Library_ColumnLastPlayed" />
                            <FontIcon FontSize="10" Glyph="{x:Bind vm:LibraryFormat.SortGlyph(ViewModel.ActiveSortColumn, ViewModel.SortDescending, 'lastplayed'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="6" Tag="installed" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnColumnHeaderClick" IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Uid="Library_ColumnInstalled" />
                            <FontIcon FontSize="10" Glyph="{x:Bind vm:LibraryFormat.SortGlyph(ViewModel.ActiveSortColumn, ViewModel.SortDescending, 'installed'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="7"
                        Tag="favorite"
                        Style="{StaticResource ColumnHeaderButtonStyle}"
                        Click="OnColumnHeaderClick"
                        IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}"
                        x:Uid="Library_ColumnFavorite">
                        <FontIcon FontSize="12" Glyph="{x:Bind vm:LibraryFormat.FavoriteHeaderGlyph(ViewModel.ActiveSortColumn, ViewModel.SortDescending), Mode=OneWay}" />
                    </Button>
                </Grid>

                <!-- Loading: skeleton rows. -->
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind SkeletonItems}"
                    Padding="18,0,18,18"
                    SelectionMode="None"
                    IsHitTestVisible="False"
                    IsTabStop="False"
                    ItemContainerStyle="{StaticResource RowContainerStyle}"
                    Visibility="{x:Bind ViewModel.IsListSkeletonShown, Mode=OneWay}"
                    x:Uid="Library_LoadingGamesList">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <Grid Height="44" Padding="12,0,12,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <controls:Skeleton Width="64" Height="30" CornerRadius="3" />
                                <controls:Skeleton Grid.Column="1" Width="200" Height="14" HorizontalAlignment="Left" />
                                <controls:Skeleton Grid.Column="2" Height="12" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView
                    x:Name="GamesList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                    Padding="18,0,18,18"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnGameClick"
                    ContainerContentChanging="OnContainerContentChanging"
                    ItemContainerStyle="{StaticResource RowContainerStyle}"
                    Visibility="{x:Bind ViewModel.IsListViewShown, Mode=OneWay}"
                    x:Uid="Library_GamesList">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameCardViewModel">
                            <library:GameListRow Card="{x:Bind}" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- No matches. -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsNoMatches, Mode=OneWay}">
                <FontIcon Glyph="&#xE721;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Uid="Library_NoMatchesTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    x:Uid="Library_NoMatchesHint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
                <Button
                    x:Uid="Library_ClearSearchAndFilters"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ClearSearchAndFiltersCommand}" />
            </StackPanel>

            <!-- Library empty. -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsLibraryEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE7FC;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Uid="Library_EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    x:Uid="Library_EmptyHint"
                    TextWrapping="Wrap"
                    MaxWidth="420"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Uid="Library_EmptyRefresh" HorizontalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
