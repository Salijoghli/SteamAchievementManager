<Window
    x:Class="SAM.App.Views.LibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SAM.App.Controls"
    xmlns:library="using:SAM.App.Views.Library"
    xmlns:vm="using:SAM.App.ViewModels">

    <Grid
        x:Name="Root"
        RequestedTheme="{x:Bind ViewModel.RequestedTheme, Mode=OneWay}"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearchAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <!-- Cards draw their own hover/press visuals; keep the container's overlay out of the way. -->
            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />

            <!-- Cards fill their slot; slot size is computed from the window width in code-behind. -->
            <Style x:Key="CardContainerStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                <Setter Property="Margin" Value="6" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!-- List view rows: the row control draws its own columns. -->
            <Style x:Key="RowContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Margin" Value="0,1,0,1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!-- Clickable list view column headers. -->
            <Style x:Key="ColumnHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="28" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Header, notices and grid share one centred column on very wide screens. -->
            <x:Double x:Key="ContentMaxWidth">2400</x:Double>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="SummaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (drag region). -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/SAM.ico" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                Text="Steam Achievement Manager"
                Style="{StaticResource CaptionTextBlockStyle}"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Page switcher: the library and the pages next to it. -->
        <SelectorBar
            x:Name="PageSelector"
            Grid.Row="1"
            Margin="16,0,16,4"
            MaxWidth="{StaticResource ContentMaxWidth}"
            HorizontalAlignment="Stretch"
            SelectionChanged="OnPageSelectionChanged">
            <SelectorBarItem x:Name="LibraryPageItem" Text="Library" Tag="library" IsSelected="True">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE8F1;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Stats" Tag="stats">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE9D2;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Activity" Tag="activity">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE7C1;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="History" Tag="history">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!-- Non-library pages (Stats, Activity, History) replace the library rows below. -->
        <ContentControl
            x:Name="PageHost"
            Grid.Row="2"
            Grid.RowSpan="3"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False"
            Visibility="Collapsed" />

        <!-- Header: search, actions, summary, sort and filters. -->
        <Grid x:Name="LibraryHeader" Grid.Row="2" Padding="24,4,24,8" RowSpacing="12" MaxWidth="{StaticResource ContentMaxWidth}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    MaxWidth="720"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="Search games or App ID"
                    QueryIcon="Find"
                    UpdateTextOnSelect="False"
                    Text="{x:Bind ViewModel.SearchText, Mode=OneWay}"
                    AutomationProperties.Name="Search games or App ID"
                    ToolTipService.ToolTip="Search games or App ID (Ctrl+F)"
                    TextChanged="OnSearchTextChanged"
                    QuerySubmitted="OnSearchQuerySubmitted"
                    PreviewKeyDown="OnSearchPreviewKeyDown" />

                <!-- Collection picker. -->
                <DropDownButton
                    Grid.Column="1"
                    Height="34"
                    AutomationProperties.Name="Collection"
                    ToolTipService.ToolTip="Show a collection">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                        <TextBlock
                            Text="{x:Bind ViewModel.CollectionFilterName, Mode=OneWay}"
                            MaxWidth="160"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="CollectionMenu" Placement="BottomEdgeAlignedLeft" Opening="OnCollectionMenuOpening">
                            <MenuFlyoutItem Text="All games" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Smart lists. -->
                <DropDownButton
                    Grid.Column="2"
                    Height="34"
                    AutomationProperties.Name="Smart lists"
                    ToolTipService.ToolTip="Smart lists">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE945;" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.SmartListName, Mode=OneWay}" />
                        <InfoBadge
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsSmartListActive, Mode=OneWay}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SmartListMenu" Placement="BottomEdgeAlignedLeft" Opening="OnSmartListMenuOpening">
                            <MenuFlyoutItem Text="None" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Grid / list view. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                    <ToggleButton
                        x:Name="GridModeButton"
                        Width="36"
                        Height="34"
                        Padding="0"
                        Click="OnGridModeClick"
                        AutomationProperties.Name="Grid view"
                        ToolTipService.ToolTip="Grid view">
                        <FontIcon Glyph="&#xF0E2;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="ListModeButton"
                        Width="36"
                        Height="34"
                        Padding="0"
                        Click="OnListModeClick"
                        AutomationProperties.Name="List view"
                        ToolTipService.ToolTip="List view">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                    </ToggleButton>
                </StackPanel>

                <Button
                    Grid.Column="4"
                    Style="{StaticResource IconButtonStyle}"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    AutomationProperties.Name="Refresh library"
                    ToolTipService.ToolTip="Refresh library (F5)">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
                <Button
                    Grid.Column="5"
                    Style="{StaticResource IconButtonStyle}"
                    AutomationProperties.Name="More options"
                    ToolTipService.ToolTip="More options">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Export library (CSV)…" Click="OnExportLibraryClick" IsEnabled="{x:Bind vm:LibraryFormat.Not(ViewModel.IsExporting), Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEDE1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Export all achievements (CSV)…" Click="OnExportAchievementsClick" IsEnabled="{x:Bind vm:LibraryFormat.Not(ViewModel.IsExporting), Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEDE1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Manage collections…" Click="OnManageCollectionsClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8F4;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    Grid.Column="6"
                    Style="{StaticResource IconButtonStyle}"
                    Click="OnSettingsClick"
                    AutomationProperties.Name="Settings"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Summary. -->
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Grid VerticalAlignment="Center">
                        <controls:Skeleton
                            Width="90"
                            Height="14"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind vm:LibraryFormat.CollapsedIf(ViewModel.IsLoading), Mode=OneWay}" />
                    </Grid>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="16"
                        Visibility="{x:Bind vm:LibraryFormat.CollapsedIf(ViewModel.IsSummaryReady), Mode=OneWay}">
                        <controls:Skeleton Width="90" Height="14" />
                        <controls:Skeleton Width="70" Height="14" />
                        <controls:Skeleton Width="90" Height="14" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.IsSummaryReady, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="{x:Bind ViewModel.CompletionDetail, Mode=OneWay}">
                            <FontIcon Glyph="&#xE9D5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CompletionText, Mode=OneWay}" Style="{StaticResource SummaryTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="Games with every achievement unlocked">
                            <FontIcon Glyph="&#xE7C1;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PerfectText, Mode=OneWay}" Style="{StaticResource SummaryTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="Total playtime">
                            <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalPlaytimeText, Mode=OneWay}" Style="{StaticResource SummaryTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <ProgressRing
                        Width="16"
                        Height="16"
                        IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                        AutomationProperties.Name="Refreshing library"
                        ToolTipService.ToolTip="Refreshing library…" />
                </StackPanel>

                <!-- Sort and filters. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox
                        Width="170"
                        IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                        AutomationProperties.Name="Sort by"
                        ToolTipService.ToolTip="Sort by">
                        <x:String>Name</x:String>
                        <x:String>App ID</x:String>
                        <x:String>Recently played</x:String>
                        <x:String>Playtime</x:String>
                        <x:String>Completion %</x:String>
                    </ComboBox>
                    <ToggleButton
                        Width="36"
                        Height="32"
                        Padding="0"
                        IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.SortDescending, Mode=TwoWay}"
                        AutomationProperties.Name="Sort descending"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SortDirectionLabel, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.SortDirectionGlyph, Mode=OneWay}" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton
                        Width="36"
                        Height="32"
                        Padding="0"
                        IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.PinFavorites, Mode=TwoWay}"
                        AutomationProperties.Name="Pin favorites to top"
                        ToolTipService.ToolTip="Pin favorites to top">
                        <FontIcon Glyph="&#xE718;" FontSize="14" />
                    </ToggleButton>
                    <DropDownButton AutomationProperties.Name="Filters" ToolTipService.ToolTip="Filters">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71C;" FontSize="14" />
                            <TextBlock Text="Filters" />
                            <InfoBadge
                                Value="{x:Bind ViewModel.ActiveFilterBadge, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Show" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <CheckBox Content="Games" IsChecked="{x:Bind ViewModel.ShowGames, Mode=TwoWay}" />
                                        <CheckBox Content="Demos" IsChecked="{x:Bind ViewModel.ShowDemos, Mode=TwoWay}" />
                                        <CheckBox Content="Mods" IsChecked="{x:Bind ViewModel.ShowMods, Mode=TwoWay}" />
                                        <CheckBox Content="Junk" IsChecked="{x:Bind ViewModel.ShowJunk, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <ToggleSwitch Header="Favorites only" IsOn="{x:Bind ViewModel.FavoritesOnly, Mode=TwoWay}" />
                                        <ToggleSwitch Header="Installed only" IsOn="{x:Bind ViewModel.InstalledOnly, Mode=TwoWay}" />
                                        <ToggleSwitch Header="Show hidden games" IsOn="{x:Bind ViewModel.ShowHidden, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <ComboBox
                                            Header="Achievements"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}"
                                            SelectedIndex="{x:Bind ViewModel.CompletionFilterIndex, Mode=TwoWay}">
                                            <x:String>All</x:String>
                                            <x:String>Has achievements</x:String>
                                            <x:String>Not started</x:String>
                                            <x:String>In progress</x:String>
                                            <x:String>Perfect</x:String>
                                        </ComboBox>
                                        <TextBlock
                                            Text="Ignored while a smart list is active."
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Visibility="{x:Bind ViewModel.IsSmartListActive, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <ComboBox
                                            Header="Last played"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="{x:Bind ViewModel.LastPlayedFilterIndex, Mode=TwoWay}">
                                            <x:String>Any time</x:String>
                                            <x:String>Today</x:String>
                                            <x:String>Past 7 days</x:String>
                                            <x:String>Past 30 days</x:String>
                                            <x:String>This year</x:String>
                                            <x:String>Never played</x:String>
                                            <x:String>Custom range</x:String>
                                        </ComboBox>
                                        <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsCustomRange, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CalendarDatePicker
                                                Header="From"
                                                PlaceholderText="Any"
                                                HorizontalAlignment="Stretch"
                                                Date="{x:Bind ViewModel.CustomFrom, Mode=TwoWay}" />
                                            <CalendarDatePicker
                                                Grid.Column="1"
                                                Header="To"
                                                PlaceholderText="Any"
                                                HorizontalAlignment="Stretch"
                                                Date="{x:Bind ViewModel.CustomTo, Mode=TwoWay}" />
                                        </Grid>
                                    </StackPanel>
                                    <Button
                                        Content="Reset filters"
                                        HorizontalAlignment="Right"
                                        Command="{x:Bind ViewModel.ResetFiltersCommand}"
                                        IsEnabled="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Notices. -->
        <StackPanel x:Name="LibraryNotices" Grid.Row="3" Padding="24,0,24,0" Spacing="8" MaxWidth="{StaticResource ContentMaxWidth}">
            <ProgressBar
                IsIndeterminate="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                Opacity="{x:Bind vm:LibraryFormat.OpacityIf(ViewModel.IsRefreshing), Mode=OneWay}"
                AutomationProperties.Name="Refreshing library" />
            <InfoBar
                Title="Couldn't load your library"
                Message="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                Severity="Error"
                IsOpen="{x:Bind ViewModel.IsLoadErrorOpen, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsLoadErrorOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Retry" Command="{x:Bind ViewModel.RefreshCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                Title="Couldn't refresh"
                Message="{x:Bind ViewModel.RefreshWarning, Mode=OneWay}"
                Severity="Warning"
                IsOpen="{x:Bind ViewModel.IsRefreshWarningOpen, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsRefreshWarningOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Retry" Command="{x:Bind ViewModel.RefreshCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                Message="{x:Bind ViewModel.AccountNoticeMessage, Mode=OneWay}"
                Severity="Informational"
                IsOpen="{x:Bind ViewModel.IsAccountNoticeOpen, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsAccountNoticeOpen, Mode=OneWay}" />
            <InfoBar
                Title="{x:Bind ViewModel.UpdateTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}"
                Severity="Informational"
                IsOpen="{x:Bind ViewModel.IsUpdateOpen, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsUpdateOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Download" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.DownloadUpdateCommand}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <Button Content="Skip this version" Margin="0,0,0,12" Command="{x:Bind ViewModel.SkipUpdateCommand}" />
                </InfoBar.Content>
            </InfoBar>
            <InfoBar
                Title="Exporting"
                Message="{x:Bind ViewModel.ExportProgressText, Mode=OneWay}"
                Severity="Informational"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsExporting, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay}">
                <InfoBar.Content>
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsExporting, Mode=OneWay}" Margin="0,0,0,12" />
                </InfoBar.Content>
            </InfoBar>
            <InfoBar
                Title="Export complete"
                Message="{x:Bind ViewModel.ExportDoneMessage, Mode=OneWay}"
                Severity="Success"
                IsOpen="{x:Bind ViewModel.IsExportDoneOpen, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsExportDoneOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Open file" Command="{x:Bind ViewModel.OpenExportedFileCommand}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <Button Content="Open folder" Margin="0,0,0,12" Command="{x:Bind ViewModel.OpenExportedFolderCommand}" />
                </InfoBar.Content>
            </InfoBar>
            <InfoBar
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsNoticeOpen, Mode=OneWay}" />
        </StackPanel>

        <!-- Content. -->
        <Grid x:Name="LibraryContent" Grid.Row="4" MaxWidth="{StaticResource ContentMaxWidth}" SizeChanged="OnContentSizeChanged">
            <!-- Loading: skeleton cards shaped like real ones. -->
            <GridView
                x:Name="SkeletonGrid"
                ItemsSource="{x:Bind SkeletonItems}"
                Padding="18,8,18,18"
                SelectionMode="None"
                IsHitTestVisible="False"
                IsTabStop="False"
                ItemContainerStyle="{StaticResource CardContainerStyle}"
                Visibility="{x:Bind ViewModel.IsGridSkeletonShown, Mode=OneWay}"
                AutomationProperties.Name="Loading games">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" Loaded="OnCardPanelLoaded" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="x:Int32">
                        <Border
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:Skeleton CornerRadius="7,7,0,0" />
                                <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="6">
                                    <controls:Skeleton Width="170" Height="16" HorizontalAlignment="Left" />
                                    <Grid Height="34">
                                        <StackPanel Spacing="6" VerticalAlignment="Center">
                                            <controls:Skeleton Height="4" CornerRadius="2" />
                                            <controls:Skeleton Width="110" Height="12" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Grid>
                                    <controls:Skeleton Width="140" Height="12" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <GridView
                x:Name="GamesGrid"
                ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                Padding="18,8,18,18"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnGameClick"
                ContainerContentChanging="OnContainerContentChanging"
                ItemContainerStyle="{StaticResource CardContainerStyle}"
                Visibility="{x:Bind ViewModel.IsGridViewShown, Mode=OneWay}"
                AutomationProperties.Name="Games">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" Loaded="OnCardPanelLoaded" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameCardViewModel">
                        <library:GameCard Card="{x:Bind}" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- List view: a column header row (click to sort) above a virtualized list. -->
            <Grid Visibility="{x:Bind ViewModel.IsListView, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column widths must match GameListRow. -->
                <Grid
                    Margin="18,8,18,0"
                    Padding="12,0,12,0"
                    Height="32"
                    ColumnSpacing="12"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Tag="name" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnColumnHeaderClick" IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Name" />
                            <FontIcon FontSize="10" Glyph="{x:Bind vm:LibraryFormat.SortGlyph(ViewModel.ActiveSortColumn, ViewModel.SortDescending, 'name'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Tag="progress" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnColumnHeaderClick" IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Progress" />
                            <FontIcon FontSize="10" Glyph="{x:Bind vm:LibraryFormat.SortGlyph(ViewModel.ActiveSortColumn, ViewModel.SortDescending, 'progress'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Tag="progress" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnColumnHeaderClick" IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}">
                        <TextBlock Text="%" />
                    </Button>
                    <Button Grid.Column="4" Tag="playtime" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnColumnHeaderClick" IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Playtime" />
                            <FontIcon FontSize="10" Glyph="{x:Bind vm:LibraryFormat.SortGlyph(ViewModel.ActiveSortColumn, ViewModel.SortDescending, 'playtime'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5" Tag="lastplayed" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnColumnHeaderClick" IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Last played" />
                            <FontIcon FontSize="10" Glyph="{x:Bind vm:LibraryFormat.SortGlyph(ViewModel.ActiveSortColumn, ViewModel.SortDescending, 'lastplayed'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="6" Tag="installed" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnColumnHeaderClick" IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Installed" />
                            <FontIcon FontSize="10" Glyph="{x:Bind vm:LibraryFormat.SortGlyph(ViewModel.ActiveSortColumn, ViewModel.SortDescending, 'installed'), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="7"
                        Tag="favorite"
                        Style="{StaticResource ColumnHeaderButtonStyle}"
                        Click="OnColumnHeaderClick"
                        IsEnabled="{x:Bind ViewModel.IsSortEnabled, Mode=OneWay}"
                        AutomationProperties.Name="Favorite"
                        ToolTipService.ToolTip="Favorite">
                        <FontIcon FontSize="12" Glyph="{x:Bind vm:LibraryFormat.FavoriteHeaderGlyph(ViewModel.ActiveSortColumn, ViewModel.SortDescending), Mode=OneWay}" />
                    </Button>
                </Grid>

                <!-- Loading: skeleton rows. -->
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind SkeletonItems}"
                    Padding="18,0,18,18"
                    SelectionMode="None"
                    IsHitTestVisible="False"
                    IsTabStop="False"
                    ItemContainerStyle="{StaticResource RowContainerStyle}"
                    Visibility="{x:Bind ViewModel.IsListSkeletonShown, Mode=OneWay}"
                    AutomationProperties.Name="Loading games">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <Grid Height="44" Padding="12,0,12,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <controls:Skeleton Width="64" Height="30" CornerRadius="3" />
                                <controls:Skeleton Grid.Column="1" Width="200" Height="14" HorizontalAlignment="Left" />
                                <controls:Skeleton Grid.Column="2" Height="12" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView
                    x:Name="GamesList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                    Padding="18,0,18,18"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnGameClick"
                    ContainerContentChanging="OnContainerContentChanging"
                    ItemContainerStyle="{StaticResource RowContainerStyle}"
                    Visibility="{x:Bind ViewModel.IsListViewShown, Mode=OneWay}"
                    AutomationProperties.Name="Games">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameCardViewModel">
                            <library:GameListRow Card="{x:Bind}" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- No matches. -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsNoMatches, Mode=OneWay}">
                <FontIcon Glyph="&#xE721;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No games match" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Try a different search or loosen your filters."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
                <Button
                    Content="Clear search and filters"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ClearSearchAndFiltersCommand}" />
            </StackPanel>

            <!-- Library empty. -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsLibraryEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE7FC;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No games found" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    Text="None of the games in SAM's list are owned by this Steam account. Search for an App ID to add one."
                    TextWrapping="Wrap"
                    MaxWidth="420"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="Refresh" HorizontalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
