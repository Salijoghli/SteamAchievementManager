<UserControl
    x:Class="SAM.App.Views.QuickSwitcher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SAM.App.Controls"
    xmlns:vm="using:SAM.App.ViewModels">

    <!-- Ctrl+K command palette: type to filter owned games, arrows + Enter to open one. -->
    <Border
        Padding="8"
        CornerRadius="8"
        BorderThickness="1"
        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        Translation="0,0,32">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="QueryBox"
                x:Uid="Switcher_QueryBox"
                IsSpellCheckEnabled="False"
                TextChanged="OnQueryChanged"
                PreviewKeyDown="OnQueryPreviewKeyDown" />

            <ListView
                x:Name="ResultsList"
                Grid.Row="1"
                MaxHeight="440"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="OnResultClick"
                ContainerContentChanging="OnResultContainerContentChanging">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameCardViewModel">
                        <Grid Height="48" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="64" Height="30" CornerRadius="3" VerticalAlignment="Center">
                                <controls:Skeleton CornerRadius="0" Visibility="{x:Bind vm:LibraryFormat.VisibleIf(IsImagePending), Mode=OneWay}" />
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind vm:LibraryFormat.VisibleIf(ImageFailed), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="14" Foreground="White" />
                                </Border>
                                <Image Source="{x:Bind vm:LibraryFormat.Thumbnail(ImagePath), Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                <TextBlock
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Text="{x:Bind AppIdText}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Width="96"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind ProgressCountText, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ProgressBar
                                    Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                    Maximum="100"
                                    Visibility="{x:Bind vm:LibraryFormat.VisibleIf(HasAchievements), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="NoMatchesText"
                x:Uid="Switcher_NoMatches"
                Grid.Row="1"
                Margin="12,8,12,8"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />

            <TextBlock
                x:Uid="Switcher_Hint"
                Grid.Row="2"
                Margin="4,0,4,0"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>
    </Border>
</UserControl>
