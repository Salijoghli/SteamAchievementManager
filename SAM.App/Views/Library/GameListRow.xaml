<UserControl
    x:Class="SAM.App.Views.Library.GameListRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SAM.App.Controls"
    xmlns:vm="using:SAM.App.ViewModels">

    <!-- Column widths must match the header row in LibraryWindow.xaml. -->
    <Grid
        Height="44"
        Padding="12,0,12,0"
        ColumnSpacing="12"
        Background="Transparent"
        Opacity="{x:Bind Card.CardOpacity, Mode=OneWay}"
        ToolTipService.ToolTip="{x:Bind Card.ToolTipText, Mode=OneWay}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" MinWidth="160" />
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="84" />
            <ColumnDefinition Width="36" />
        </Grid.ColumnDefinitions>

        <!-- Thumbnail (the card image, 460x215 aspect). -->
        <Grid Width="64" Height="30" CornerRadius="3" VerticalAlignment="Center">
            <controls:Skeleton CornerRadius="0" Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.IsImagePending), Mode=OneWay}" />
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.ImageFailed), Mode=OneWay}">
                <FontIcon Glyph="&#xE7FC;" FontSize="14" Foreground="White" />
            </Border>
            <Image Source="{x:Bind vm:LibraryFormat.Thumbnail(Card.ImagePath), Mode=OneWay}" Stretch="UniformToFill" />
        </Grid>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock
                Text="{x:Bind Card.Name, Mode=OneWay}"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                VerticalAlignment="Center" />
            <Grid VerticalAlignment="Center" Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.HasSmartBadge), Mode=OneWay}">
                <controls:Skeleton
                    Width="72"
                    Height="14"
                    Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.IsSmartBadgeLoading), Mode=OneWay}" />
                <Border
                    Padding="6,0,6,1"
                    CornerRadius="8"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Visibility="{x:Bind vm:LibraryFormat.CollapsedIf(Card.IsSmartBadgeLoading), Mode=OneWay}">
                    <TextBlock
                        Text="{x:Bind Card.SmartBadge, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </Grid>
        </StackPanel>

        <!-- Progress. -->
        <Grid Grid.Column="2" VerticalAlignment="Center">
            <controls:Skeleton Height="12" Visibility="{x:Bind vm:LibraryFormat.CollapsedIf(Card.IsProgressLoaded), Mode=OneWay}" />
            <Grid ColumnSpacing="8" Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.IsProgressLoaded), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    Value="{x:Bind Card.ProgressPercent, Mode=OneWay}"
                    Maximum="100"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.HasAchievements), Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Card.ProgressCountText, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <!-- Achievement data Steam hasn't downloaded ("?/78"): "Load achievements". -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{x:Bind Card.ProgressText, Mode=OneWay}"
                    Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.IsAchievementDataMissing), Mode=OneWay}">
                    <Button
                        Width="24"
                        Height="24"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind Card.LoadAchievementsCommand, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Card.LoadAchievementsLabel}"
                        ToolTipService.ToolTip="{x:Bind Card.LoadAchievementsLabel}"
                        Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.CanLoadAchievements), Mode=OneWay}">
                        <FontIcon Glyph="&#xE896;" FontSize="12" />
                    </Button>
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind Card.IsFetchingAchievements, Mode=OneWay}"
                        Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.IsFetchingAchievements), Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock
            Grid.Column="3"
            Text="{x:Bind Card.PercentText, Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            VerticalAlignment="Center"
            Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.IsProgressLoaded), Mode=OneWay}" />

        <TextBlock
            Grid.Column="4"
            Text="{x:Bind Card.PlaytimeShortText, Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            VerticalAlignment="Center"
            Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.IsPlaytimeLoaded), Mode=OneWay}" />

        <TextBlock
            Grid.Column="5"
            Text="{x:Bind Card.LastPlayedText, Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.IsPlaytimeLoaded), Mode=OneWay}" />

        <TextBlock
            Grid.Column="6"
            Text="{x:Bind Card.InstalledText, Mode=OneWay}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            VerticalAlignment="Center" />

        <ToggleButton
            Grid.Column="7"
            Width="32"
            Height="28"
            Padding="0"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            IsChecked="{x:Bind Card.IsFavorite, Mode=TwoWay}"
            AutomationProperties.Name="{x:Bind Card.FavoriteLabel, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Card.FavoriteLabel, Mode=OneWay}">
            <ToggleButton.Resources>
                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#19808080" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#33808080" />
                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFC83D" />
                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFD86B" />
                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFC83D" />
            </ToggleButton.Resources>
            <FontIcon Glyph="{x:Bind Card.FavoriteGlyph, Mode=OneWay}" FontSize="14" />
        </ToggleButton>
    </Grid>
</UserControl>
