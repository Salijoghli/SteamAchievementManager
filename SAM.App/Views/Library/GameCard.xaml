<UserControl
    x:Class="SAM.App.Views.Library.GameCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SAM.App.Controls"
    xmlns:vm="using:SAM.App.ViewModels"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    PointerCanceled="OnPointerExited"
    PointerCaptureLost="OnPointerExited">

    <Grid x:Name="CardRoot" Opacity="{x:Bind Card.CardOpacity, Mode=OneWay}">
    <Border
        Background="{ThemeResource CardBackgroundBrush}"
        BorderBrush="{ThemeResource CardBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource CardCornerRadius}"
        ToolTipService.ToolTip="{x:Bind Card.ToolTipText, Mode=OneWay}">
        <Grid>
            <!-- The card fills a slot sized by LibraryWindow so the image area keeps a 460x215 aspect. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header image (460x215 aspect): skeleton until loaded, fallback if unavailable. -->
            <Grid CornerRadius="7,7,0,0">
                <controls:Skeleton x:Name="ImageSkeleton" CornerRadius="0" />

                <Grid x:Name="ImageFallback" Visibility="Collapsed">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorDark1}" />
                            <GradientStop Offset="1" Color="{ThemeResource SystemAccentColorDark3}" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <FontIcon Glyph="&#xE7FC;" FontSize="28" Foreground="White" Opacity="0.85" />
                        <TextBlock
                            Text="{x:Bind Card.AppIdText, Mode=OneWay}"
                            Foreground="White"
                            Opacity="0.7"
                            FontSize="12"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Image
                    x:Name="HeaderImage"
                    Stretch="UniformToFill"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0"
                    ImageOpened="OnImageOpened"
                    ImageFailed="OnImageFailed" />

                <ToggleButton
                    x:Name="FavoriteButton"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Margin="0,8,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    CornerRadius="16"
                    Background="#99000000"
                    BorderThickness="0"
                    IsChecked="{x:Bind Card.IsFavorite, Mode=TwoWay}"
                    AutomationProperties.Name="{x:Bind Card.FavoriteLabel, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Card.FavoriteLabel, Mode=OneWay}">
                    <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#CC000000" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#E6000000" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#99000000" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#CC000000" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#E6000000" />
                        <SolidColorBrush x:Key="ToggleButtonForeground" Color="White" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="White" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFC83D" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFD86B" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFC83D" />
                    </ToggleButton.Resources>
                    <FontIcon Glyph="{x:Bind Card.FavoriteGlyph, Mode=OneWay}" FontSize="14" />
                </ToggleButton>

                <!-- Installed badge. -->
                <Border
                    Margin="8,8,0,0"
                    Padding="8,2,8,3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    CornerRadius="10"
                    Background="#99000000"
                    Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.IsInstalled), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="White" />
                        <TextBlock Text="Installed" FontSize="11" Foreground="White" />
                    </StackPanel>
                </Border>

                <!-- Play / Install, shown on hover. -->
                <Button
                    x:Name="PlayButton"
                    Margin="8,0,0,8"
                    Padding="10,4,12,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    CornerRadius="14"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind Card.PlayCommand, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Card.PlayLabel, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Card.PlayLabel, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{x:Bind Card.PlayGlyph, Mode=OneWay}" FontSize="12" />
                        <TextBlock Text="{x:Bind Card.PlayLabel, Mode=OneWay}" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Padding="12,10,12,12" Spacing="6">
                <TextBlock
                    Text="{x:Bind Card.Name, Mode=OneWay}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    MaxLines="1" />

                <!-- Achievement progress. -->
                <Grid Height="34">
                    <StackPanel
                        Spacing="6"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind vm:LibraryFormat.CollapsedIf(Card.IsProgressLoaded), Mode=OneWay}">
                        <controls:Skeleton Height="4" CornerRadius="2" />
                        <controls:Skeleton Width="110" Height="12" />
                    </StackPanel>
                    <StackPanel
                        Spacing="6"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.IsProgressLoaded), Mode=OneWay}">
                        <Grid>
                            <ProgressBar
                                Value="{x:Bind Card.ProgressPercent, Mode=OneWay}"
                                Maximum="100"
                                Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.HasAchievements), Mode=OneWay}" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    Glyph="&#xE7C1;"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.IsPerfect), Mode=OneWay}" />
                                <TextBlock
                                    Text="{x:Bind Card.ProgressText, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <!-- Smart list badge, e.g. "3 left" or "Rarest 0.4%". -->
                            <Grid Grid.Column="1" Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.HasSmartBadge), Mode=OneWay}">
                                <controls:Skeleton
                                    Width="72"
                                    Height="14"
                                    Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.IsSmartBadgeLoading), Mode=OneWay}" />
                                <Border
                                    Padding="6,0,6,1"
                                    CornerRadius="8"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind vm:LibraryFormat.CollapsedIf(Card.IsSmartBadgeLoading), Mode=OneWay}">
                                    <TextBlock
                                        Text="{x:Bind Card.SmartBadge, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Playtime and last played. -->
                <Grid Height="16">
                    <controls:Skeleton
                        Width="140"
                        Height="12"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind vm:LibraryFormat.CollapsedIf(Card.IsPlaytimeLoaded), Mode=OneWay}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="{x:Bind vm:LibraryFormat.VisibleIf(Card.IsPlaytimeLoaded), Mode=OneWay}">
                        <FontIcon Glyph="&#xE823;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="{x:Bind Card.PlaytimeText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
    <Border
        x:Name="HoverBorder"
        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource CardCornerRadius}"
        IsHitTestVisible="False"
        Opacity="0" />
    </Grid>
</UserControl>
