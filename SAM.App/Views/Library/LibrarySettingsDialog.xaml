<ContentDialog
    x:Class="SAM.App.Views.Library.LibrarySettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SAM.App.Controls"
    x:Uid="Settings_Dialog"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Width="420" Spacing="20">
            <StackPanel Spacing="8">
                <TextBlock x:Uid="Settings_Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <RadioButtons
                    x:Uid="Settings_Theme"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                    MaxColumns="3">
                    <RadioButton x:Uid="Settings_ThemeSystem" />
                    <RadioButton x:Uid="Settings_ThemeLight" />
                    <RadioButton x:Uid="Settings_ThemeDark" />
                </RadioButtons>
                <RadioButtons
                    x:Uid="Settings_Language"
                    SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}"
                    MaxColumns="2">
                    <RadioButton x:Uid="Settings_LanguageEnglish" />
                    <RadioButton x:Uid="Settings_LanguageGeorgian" />
                </RadioButtons>
                <InfoBar
                    x:Uid="Settings_RestartNeeded"
                    Severity="Informational"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsRestartNeeded, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsRestartNeeded, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button x:Uid="Settings_RestartNow" Command="{x:Bind ViewModel.RestartAppCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="Settings_Library" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ToggleSwitch
                    x:Uid="Settings_KeepOtherAccountsCache"
                    IsOn="{x:Bind ViewModel.KeepOtherAccountsCache, Mode=TwoWay}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Uid="Settings_CacheSize" />
                        <Grid>
                            <controls:Skeleton x:Name="CacheSizeSkeleton" Width="80" Height="14" HorizontalAlignment="Left" />
                            <TextBlock
                                x:Name="CacheSizeText"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                    <Button x:Name="ClearCacheButton" x:Uid="Settings_ClearCache" Grid.Column="1">
                        <Button.Flyout>
                            <Flyout x:Name="ConfirmFlyout">
                                <StackPanel Width="280" Spacing="12">
                                    <TextBlock
                                        x:Uid="Settings_ClearCacheConfirm"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Uid="Settings_ClearCacheConfirmButton"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="OnConfirmClearCache" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="Settings_GameWindow" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ToggleSwitch
                    x:Uid="Settings_SpoilerProtection"
                    IsOn="{x:Bind ViewModel.SpoilerProtection, Mode=TwoWay}" />
                <TextBlock
                    x:Uid="Settings_SpoilerProtectionHint"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Margin="0,-8,0,0" />
                <ToggleSwitch
                    x:Uid="Settings_BackupBeforeCommit"
                    IsOn="{x:Bind ViewModel.BackupBeforeCommit, Mode=TwoWay}" />
                <TextBlock
                    x:Uid="Settings_BackupBeforeCommitHint"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Margin="0,-8,0,0" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="Settings_App" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ToggleSwitch
                    x:Uid="Settings_MinimizeToTray"
                    IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
                <ToggleSwitch
                    x:Uid="Settings_ShowNotifications"
                    IsOn="{x:Bind ViewModel.ShowNotifications, Mode=TwoWay}" />
                <ToggleSwitch
                    x:Uid="Settings_CheckForUpdates"
                    IsOn="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="VersionText" />
                        <TextBlock
                            x:Name="UpdateStatusText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="UpdateProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                        <Button x:Name="CheckNowButton" x:Uid="Settings_CheckNow" Click="OnCheckNowClick" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Uid="Settings_SteamAccount" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Spacing="2">
                    <TextBlock Text="SteamID64" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SteamIdText}"
                        IsTextSelectionEnabled="True"
                        FontFamily="Consolas"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
