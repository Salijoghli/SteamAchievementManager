<Window
    x:Class="SAM.App.Views.GameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SAM.App.Controls"
    xmlns:charts="using:SAM.App.Controls.Charts"
    xmlns:game="using:SAM.App.Views.Game"
    xmlns:vm="using:SAM.App.ViewModels">

    <!-- Hidden: otherwise WinUI shows the window-wide shortcuts (Ctrl+F etc.) as a tooltip
         on everything inside this grid. -->
    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            </Style>
        </Grid.Resources>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnCommitAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnReloadAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (content is extended into it). -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/SAM.ico" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis">
                <Run Text="{x:Bind ViewModel.GameName}" />
                <Run x:Uid="Game_TitleSuffix" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1" Padding="24,4,24,0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header card. -->
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="246" Height="115" CornerRadius="6">
                        <controls:Skeleton
                            CornerRadius="6"
                            Visibility="{x:Bind game:GameFormat.Collapsed(ViewModel.IsHeaderImageLoaded), Mode=OneWay}" />
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind ViewModel.IsHeaderImageMissing, Mode=OneWay}">
                            <FontIcon Glyph="&#xE7FC;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Border>
                        <Image
                            Source="{x:Bind ViewModel.HeaderImage, Mode=OneWay}"
                            Stretch="UniformToFill"
                            x:Uid="Game_HeaderImage"
                            Opacity="{x:Bind game:GameFormat.Opacity(ViewModel.IsHeaderImageLoaded), Mode=OneWay}">
                            <Image.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.4" />
                            </Image.OpacityTransition>
                        </Image>
                        <Rectangle IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0.45" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#59000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock
                            Text="{x:Bind ViewModel.GameName}"
                            Style="{StaticResource TitleTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="2"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{x:Bind ViewModel.AppIdText}"
                            Style="{StaticResource CaptionSecondaryStyle}"
                            IsTextSelectionEnabled="True" />
                        <TextBlock
                            Text="{x:Bind ViewModel.PlaytimeText, Mode=OneWay}"
                            Style="{StaticResource CaptionSecondaryStyle}"
                            Visibility="{x:Bind ViewModel.HasPlaytime, Mode=OneWay}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            Margin="0,4,0,0"
                            Visibility="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                            <FontIcon
                                Glyph="&#xE70F;"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Visibility="{x:Bind ViewModel.HasPending, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.PendingText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Completion. -->
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="16"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                            <controls:Skeleton Width="72" Height="72" CornerRadius="36" />
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <controls:Skeleton Width="150" Height="24" />
                                <controls:Skeleton Width="110" Height="12" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="16"
                            Visibility="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                            <Grid Width="72" Height="72">
                                <ProgressRing
                                    Width="72"
                                    Height="72"
                                    IsIndeterminate="False"
                                    Maximum="100"
                                    Value="{x:Bind ViewModel.CompletionPercent, Mode=OneWay}"
                                    Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                                    x:Uid="Game_CompletionRing" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.CompletionPercentText, Mode=OneWay}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CompletionText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Uid="Game_AchievementsUnlockedCaption" Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Load errors and operation results. -->
            <StackPanel Grid.Row="1" Spacing="8">
                <InfoBar
                    x:Uid="Game_LoadErrorBar"
                    Message="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                    Severity="Error"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasLoadError, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button x:Uid="Game_LoadErrorRetry" Command="{x:Bind ViewModel.ReloadCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    x:Uid="Game_AutopilotHandover"
                    Severity="Informational"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsAutopilotHandingOver, Mode=OneWay}">
                    <ProgressBar IsIndeterminate="True" Margin="0,0,0,12" />
                </InfoBar>
                <InfoBar
                    x:Uid="Game_AutopilotPaused"
                    Severity="Informational"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsAutopilotPausedOpen, Mode=TwoWay}" />
                <InfoBar
                    x:Uid="Autopilot_GameWarning"
                    Severity="Warning"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.IsAutopilotWarningOpen, Mode=TwoWay}" />
                <InfoBar
                    Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}" />
            </StackPanel>

            <!-- Tabs and toolbar. -->
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged" VerticalAlignment="Center">
                    <SelectorBarItem x:Name="AchievementsTab" x:Uid="Game_AchievementsTab" IsSelected="True">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE734;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="StatisticsTab" x:Uid="Game_StatisticsTab">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE9D2;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="TimelineTab" x:Uid="Game_TimelineTab">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE81C;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>

                <CommandBar
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    DefaultLabelPosition="Right"
                    Background="Transparent"
                    IsOpen="False">
                    <AppBarElementContainer VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            x:Uid="Game_UnlockAllButton"
                            Command="{x:Bind ViewModel.UnlockAllCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE785;" FontSize="16" />
                                <TextBlock x:Uid="Game_UnlockAllText" />
                            </StackPanel>
                        </Button>
                    </AppBarElementContainer>
                    <AppBarElementContainer VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            x:Uid="Game_LockAllButton"
                            Command="{x:Bind ViewModel.LockAllCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" />
                                <TextBlock x:Uid="Game_LockAllText" />
                            </StackPanel>
                        </Button>
                    </AppBarElementContainer>
                    <AppBarButton
                        x:Uid="Game_InvertButton"
                        DynamicOverflowOrder="2"
                        Command="{x:Bind ViewModel.InvertCommand}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8AB;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        Icon="Refresh"
                        x:Uid="Game_ReloadButton"
                        DynamicOverflowOrder="3"
                        Click="OnReloadClick"
                        IsEnabled="{x:Bind game:GameFormat.Not(ViewModel.IsBusy), Mode=OneWay}" />
                    <AppBarButton
                        x:Uid="Game_BackupsButton"
                        DynamicOverflowOrder="4"
                        Click="OnBackupsClick"
                        IsEnabled="{x:Bind game:GameFormat.IsIdle(ViewModel.IsLoaded, ViewModel.IsBusy), Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE78C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <!-- Read-only, so it's the first to move into the overflow menu. -->
                    <AppBarButton
                        x:Uid="Game_CompareButton"
                        DynamicOverflowOrder="1"
                        Click="OnCompareClick"
                        IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE716;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <CommandBar.SecondaryCommands>
                        <AppBarToggleButton
                            x:Uid="Game_SpoilerToggle"
                            IsChecked="{x:Bind ViewModel.IsSpoilerProtectionOn, Mode=OneWay}"
                            Click="OnSpoilerProtectionClick">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xED1A;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarButton
                            x:Uid="Game_RevealAllButton"
                            Command="{x:Bind ViewModel.RevealAllHiddenCommand}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE7B3;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton
                            x:Uid="Game_ResetStatsButton"
                            Click="OnResetAllStats"
                            IsEnabled="{x:Bind game:GameFormat.IsIdle(ViewModel.IsLoaded, ViewModel.IsBusy), Mode=OneWay}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>

                <!-- Outside the CommandBar so it can never be moved into the overflow menu. -->
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    x:Uid="Game_CommitButton"
                    Command="{x:Bind ViewModel.CommitCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="16" />
                        <TextBlock Text="{x:Bind ViewModel.CommitLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Body. -->
            <Grid Grid.Row="3">
                <!-- Loading placeholder rows. -->
                <ItemsControl
                    ItemsSource="{x:Bind SkeletonRows}"
                    IsTabStop="False"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,4">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Skeleton Width="48" Height="48" CornerRadius="6" />
                                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                        <controls:Skeleton Width="220" Height="14" HorizontalAlignment="Left" />
                                        <controls:Skeleton Width="380" Height="12" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <controls:Skeleton Grid.Column="2" Width="40" Height="20" CornerRadius="10" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Achievements tab. -->
                <Grid
                    x:Name="AchievementsPanel"
                    RowSpacing="8"
                    Opacity="{x:Bind game:GameFormat.Opacity(ViewModel.IsLoaded), Mode=OneWay}">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.3" />
                    </Grid.OpacityTransition>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            x:Uid="Game_SearchBox"
                            QueryIcon="Find"
                            TextChanged="OnSearchTextChanged" />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="150"
                            x:Uid="Game_StateFilter"
                            SelectedIndex="{x:Bind ViewModel.StateFilterIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Game_StateAll" />
                            <ComboBoxItem x:Uid="Game_StateLocked" />
                            <ComboBoxItem x:Uid="Game_StateUnlocked" />
                            <ComboBoxItem x:Uid="Game_StatePending" />
                            <ComboBoxItem x:Uid="Game_StateHasNotes" />
                        </ComboBox>
                        <ComboBox
                            Grid.Column="2"
                            MinWidth="150"
                            x:Uid="Game_RarityFilter"
                            SelectedIndex="{x:Bind ViewModel.RarityFilterIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Game_RarityAny" />
                            <ComboBoxItem x:Uid="Game_RarityCommon" />
                            <ComboBoxItem x:Uid="Game_RarityUncommon" />
                            <ComboBoxItem x:Uid="Game_RarityRare" />
                            <ComboBoxItem x:Uid="Game_RarityEpic" />
                            <ComboBoxItem x:Uid="Game_RarityLegendary" />
                        </ComboBox>
                        <ComboBox
                            Grid.Column="3"
                            MinWidth="200"
                            x:Uid="Game_SortBox"
                            SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Game_SortLockedFirst" />
                            <ComboBoxItem x:Uid="Game_SortDefault" />
                            <ComboBoxItem x:Uid="Game_SortName" />
                            <ComboBoxItem x:Uid="Game_SortRarest" />
                            <ComboBoxItem x:Uid="Game_SortCommonest" />
                            <ComboBoxItem x:Uid="Game_SortNewest" />
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            MinWidth="180"
                            x:Uid="Game_DateFilter"
                            SelectedIndex="{x:Bind ViewModel.DateFilterIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Game_DateAny" />
                            <ComboBoxItem x:Uid="Game_DateToday" />
                            <ComboBoxItem x:Uid="Game_Date7Days" />
                            <ComboBoxItem x:Uid="Game_Date30Days" />
                            <ComboBoxItem x:Uid="Game_DateThisYear" />
                            <ComboBoxItem x:Uid="Game_DateCustom" />
                        </ComboBox>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsCustomDateRange, Mode=OneWay}">
                            <CalendarDatePicker
                                x:Uid="Game_DateFrom"
                                Date="{x:Bind ViewModel.CustomFrom, Mode=TwoWay}" />
                            <CalendarDatePicker
                                x:Uid="Game_DateTo"
                                Date="{x:Bind ViewModel.CustomTo, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.ShowingText, Mode=OneWay}"
                            Style="{StaticResource CaptionSecondaryStyle}" />
                    </Grid>

                    <!-- Compare with friend (read-only). -->
                    <Border
                        Grid.Row="2"
                        Style="{StaticResource CardStyle}"
                        Padding="12,8"
                        Visibility="{x:Bind ViewModel.IsComparing, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture
                                Width="32"
                                Height="32"
                                VerticalAlignment="Center"
                                DisplayName="{x:Bind ViewModel.ComparedFriendName, Mode=OneWay}"
                                ProfilePicture="{x:Bind ViewModel.ComparedFriendAvatar, Mode=OneWay}"
                                AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.ComparisonTitle, Mode=OneWay}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing
                                        Width="12"
                                        Height="12"
                                        IsActive="{x:Bind ViewModel.IsComparisonLoading, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsComparisonLoading, Mode=OneWay}" />
                                    <FontIcon
                                        Glyph="&#xE7BA;"
                                        FontSize="12"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Visibility="{x:Bind ViewModel.HasComparisonError, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind ViewModel.ComparisonStatusText, Mode=OneWay}"
                                        Style="{StaticResource CaptionSecondaryStyle}"
                                        TextWrapping="Wrap"
                                        AutomationProperties.LiveSetting="Polite" />
                                </Grid>
                            </StackPanel>
                            <ComboBox
                                Grid.Column="2"
                                MinWidth="190"
                                VerticalAlignment="Center"
                                x:Uid="Game_CompareFilter"
                                IsEnabled="{x:Bind ViewModel.IsComparisonReady, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.CompareFilterIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="Game_CompareFilterAll" />
                                <ComboBoxItem x:Uid="Game_CompareFilterOnlyFriend" />
                                <ComboBoxItem x:Uid="Game_CompareFilterOnlyMe" />
                                <ComboBoxItem x:Uid="Game_CompareFilterBoth" />
                                <ComboBoxItem x:Uid="Game_CompareFilterNeither" />
                            </ComboBox>
                            <Button
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                x:Uid="Game_CompareRetry"
                                Command="{x:Bind ViewModel.RetryComparisonCommand}"
                                Visibility="{x:Bind ViewModel.CanRetryComparison, Mode=OneWay}" />
                            <Button
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="8"
                                x:Uid="Game_CompareClear"
                                Command="{x:Bind ViewModel.ClearComparisonCommand}">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock
                        Grid.Row="3"
                        Margin="0,24"
                        HorizontalAlignment="Center"
                        x:Uid="Game_NoMatches"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.HasNoVisibleAchievements, Mode=OneWay}" />

                    <ListView
                        x:Name="AchievementList"
                        Grid.Row="3"
                        Margin="-4,0,-16,0"
                        Padding="0,0,12,16"
                        ItemsSource="{x:Bind ViewModel.VisibleAchievements}"
                        SelectionMode="None"
                        ContainerContentChanging="OnAchievementContainerContentChanging"
                        ContextRequested="OnAchievementContextRequested"
                        x:Uid="Game_AchievementList">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AchievementViewModel">
                                <!-- Right-click / Shift+F10 opens the row menu (guides, note); see OnAchievementContextRequested. -->
                                <Border
                                    Style="{StaticResource CardStyle}"
                                    Padding="0,10,14,10"
                                    PointerEntered="OnRowPointerEntered"
                                    PointerExited="OnRowPointerExited"
                                    PointerCanceled="OnRowPointerExited">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Pending change marker. -->
                                        <Border
                                            Width="4"
                                            Margin="0,-2"
                                            CornerRadius="0,2,2,0"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind IsPending, Mode=OneWay}" />

                                        <Grid Grid.Column="1" Width="48" Height="48" CornerRadius="6" VerticalAlignment="Top">
                                            <controls:Skeleton
                                                CornerRadius="6"
                                                Visibility="{x:Bind game:GameFormat.Collapsed(IsIconLoaded), Mode=OneWay}" />
                                            <Border
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind IsIconMissing, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE734;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Border>
                                            <Image
                                                Source="{x:Bind IconSource, Mode=OneWay}"
                                                Stretch="UniformToFill"
                                                Opacity="{x:Bind game:GameFormat.Opacity(IsIconLoaded), Mode=OneWay}">
                                                <Image.OpacityTransition>
                                                    <ScalarTransition Duration="0:0:0.3" />
                                                </Image.OpacityTransition>
                                            </Image>
                                        </Grid>

                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Text="{x:Bind Name}"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <FontIcon
                                                    Glyph="&#xE72E;"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind IsProtected}"
                                                    x:Uid="Game_RowProtectedIcon" />
                                                <Border
                                                    Padding="6,1"
                                                    CornerRadius="8"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{x:Bind IsPending, Mode=OneWay}">
                                                    <TextBlock
                                                        Text="{x:Bind PendingText, Mode=OneWay}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock
                                                Text="{x:Bind DisplayDescription, Mode=OneWay}"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind game:GameFormat.Collapsed(IsSpoilerMasked), Mode=OneWay}"
                                                PointerEntered="OnDescriptionPointerEntered"
                                                PointerExited="OnDescriptionPointerExited"
                                                Tapped="OnDescriptionTapped" />
                                            <!-- Spoiler mask: WinUI can't blur text, so the description isn't
                                                 rendered at all (nothing leaks to screen readers or selection);
                                                 a frosted acrylic pill stands in until it's clicked. -->
                                            <Border
                                                HorizontalAlignment="Left"
                                                Padding="10,3"
                                                CornerRadius="4"
                                                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Visibility="{x:Bind IsSpoilerMasked, Mode=OneWay}"
                                                x:Uid="Game_RowSpoilerMask"
                                                Tapped="OnDescriptionTapped">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xED1A;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock
                                                        Text="{x:Bind DisplayDescription, Mode=OneWay}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind HasNote, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE70B;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind NotePreview, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis"
                                                    MaxLines="1" />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{x:Bind UnlockTimeText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Visibility="{x:Bind HasUnlockTimeText}" />
                                            <!-- Counter achievements: progress toward the target (read-only). -->
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Margin="0,2,0,0"
                                                Visibility="{x:Bind ShowsProgress, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind ProgressAccessibleText, Mode=OneWay}">
                                                <ProgressBar
                                                    Width="160"
                                                    VerticalAlignment="Center"
                                                    Maximum="100"
                                                    Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                                    AutomationProperties.Name="{x:Bind ProgressAccessibleText, Mode=OneWay}" />
                                                <TextBlock
                                                    Text="{x:Bind ProgressText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    AutomationProperties.AccessibilityView="Raw" />
                                            </StackPanel>
                                            <!-- The compared friend has it. -->
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Margin="0,2,0,0"
                                                Visibility="{x:Bind ShowsFriendBadge, Mode=OneWay}">
                                                <PersonPicture
                                                    Width="18"
                                                    Height="18"
                                                    DisplayName="{x:Bind FriendName, Mode=OneWay}"
                                                    ProfilePicture="{x:Bind FriendAvatar, Mode=OneWay}"
                                                    AutomationProperties.AccessibilityView="Raw" />
                                                <FontIcon
                                                    Glyph="&#xE73E;"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock
                                                    Text="{x:Bind FriendBadgeText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Row actions: guides (on hover) and the note button (on hover, or
                                             filled when there's a note). The row menu offers both by keyboard. -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Padding="6"
                                                IsTabStop="False"
                                                Opacity="{x:Bind ActionOpacity, Mode=OneWay}"
                                                Click="OnGuideButtonClick"
                                                x:Uid="Game_RowGuideButton">
                                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                            </Button>
                                            <Grid>
                                                <Button
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Padding="6"
                                                    IsTabStop="False"
                                                    Opacity="{x:Bind ActionOpacity, Mode=OneWay}"
                                                    Visibility="{x:Bind HasNoNote, Mode=OneWay}"
                                                    Click="OnNoteButtonClick"
                                                    x:Uid="Game_RowAddNote">
                                                    <FontIcon Glyph="&#xE70B;" FontSize="14" />
                                                </Button>
                                                <Button
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Padding="6"
                                                    IsTabStop="False"
                                                    Visibility="{x:Bind HasNote, Mode=OneWay}"
                                                    Click="OnNoteButtonClick"
                                                    x:Uid="Game_RowEditNote">
                                                    <FontIcon Glyph="&#xE70B;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Rarity. -->
                                        <Grid Grid.Column="4" MinWidth="110" VerticalAlignment="Center">
                                            <StackPanel
                                                Spacing="6"
                                                HorizontalAlignment="Right"
                                                Visibility="{x:Bind IsRarityLoading, Mode=OneWay}">
                                                <controls:Skeleton Width="70" Height="18" CornerRadius="9" HorizontalAlignment="Right" />
                                                <controls:Skeleton Width="90" Height="10" HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <StackPanel
                                                Spacing="4"
                                                HorizontalAlignment="Right"
                                                Visibility="{x:Bind HasRarity, Mode=OneWay}">
                                                <Border
                                                    HorizontalAlignment="Right"
                                                    Padding="8,2"
                                                    CornerRadius="9"
                                                    Background="{x:Bind game:GameFormat.RarityBrush(Rarity), Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind RarityTierText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Text="{x:Bind RarityText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- The tooltip sits on a wrapper because disabled controls don't show one. -->
                                        <Border
                                            Grid.Column="5"
                                            Background="Transparent"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind game:GameFormat.ProtectedTooltip(IsProtected)}">
                                            <ToggleSwitch
                                                MinWidth="0"
                                                x:Uid="Game_RowToggle"
                                                IsOn="{x:Bind IsChecked, Mode=TwoWay}"
                                                IsEnabled="{x:Bind CanChange, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind Name}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Statistics tab. -->
                <Grid
                    x:Name="StatisticsPanel"
                    RowSpacing="8"
                    Visibility="Collapsed"
                    Opacity="{x:Bind game:GameFormat.Opacity(ViewModel.IsLoaded), Mode=OneWay}">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.3" />
                    </Grid.OpacityTransition>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <InfoBar
                        x:Uid="Game_StatsWarning"
                        Severity="Warning"
                        IsClosable="False"
                        IsOpen="True" />

                    <ToggleSwitch
                        Grid.Row="1"
                        x:Uid="Game_StatsEditToggle"
                        IsOn="{x:Bind ViewModel.IsStatEditingEnabled, Mode=TwoWay}"
                        IsEnabled="{x:Bind game:GameFormat.Not(ViewModel.IsBusy), Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,24"
                        HorizontalAlignment="Center"
                        x:Uid="Game_NoStats"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.HasNoStats, Mode=OneWay}" />

                    <ListView
                        Grid.Row="2"
                        Margin="-4,0,-16,0"
                        Padding="0,0,12,16"
                        ItemsSource="{x:Bind ViewModel.Stats}"
                        SelectionMode="None"
                        x:Uid="Game_StatsList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatViewModel">
                                <Border Style="{StaticResource CardStyle}" Padding="0,10,14,10">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="4"
                                            Margin="0,-2"
                                            CornerRadius="0,2,2,0"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind IsModified, Mode=OneWay}" />

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{x:Bind Id}"
                                                FontFamily="Consolas"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                IsTextSelectionEnabled="True" />
                                            <TextBlock
                                                Text="{x:Bind FlagsText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsReadOnly}">
                                                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind ProtectedText}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- "Used by": achievements that depend on this stat (filled in later). -->
                                            <StackPanel Margin="0,6,0,0" Spacing="2" Visibility="{x:Bind HasUsedBy, Mode=OneWay}">
                                                <TextBlock x:Uid="Game_StatUsedBy" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{x:Bind UsedBy}" IsTabStop="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:StatUsage">
                                                            <TextBlock
                                                                Text="{x:Bind Text}"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                            <NumberBox
                                                Value="{x:Bind EditValue, Mode=TwoWay}"
                                                IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                SpinButtonPlacementMode="Compact"
                                                SmallChange="1"
                                                AutomationProperties.Name="{x:Bind DisplayName}" />
                                            <TextBlock
                                                Text="{x:Bind Error, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind HasError, Mode=OneWay}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="3"
                                            MinWidth="120"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{x:Bind OriginalValueText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Visibility="{x:Bind game:GameFormat.VisibleIfAny(IsModified, HasError), Mode=OneWay}" />
                                            <Button
                                                Command="{x:Bind ResetToOriginalCommand}"
                                                IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                Visibility="{x:Bind game:GameFormat.VisibleIfAny(IsModified, HasError), Mode=OneWay}"
                                                x:Uid="Game_StatResetButton">
                                                <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Timeline tab: this game's unlocks over time. -->
                <Grid
                    x:Name="TimelinePanel"
                    Visibility="Collapsed"
                    Opacity="{x:Bind game:GameFormat.Opacity(ViewModel.IsLoaded), Mode=OneWay}">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.3" />
                    </Grid.OpacityTransition>
                    <Border Style="{StaticResource CardStyle}" Padding="16" VerticalAlignment="Top">
                        <Grid RowSpacing="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="280" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="Game_TimelineTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Grid.Row="1"
                                Text="{x:Bind ViewModel.TimelineCountText, Mode=OneWay}"
                                Style="{StaticResource CaptionSecondaryStyle}" />
                            <TextBlock
                                Grid.Row="2"
                                Text="{x:Bind ViewModel.TimelineRangeText, Mode=OneWay}"
                                Style="{StaticResource CaptionSecondaryStyle}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasTimeline, Mode=OneWay}" />
                            <ToggleButton
                                x:Name="TimelineTableToggle"
                                Grid.RowSpan="3"
                                Grid.Column="1"
                                Padding="8,3,8,4"
                                FontSize="12"
                                VerticalAlignment="Top"
                                x:Uid="Game_TimelineTableToggle"
                                IsEnabled="{x:Bind ViewModel.HasTimeline, Mode=OneWay}" />

                            <charts:AreaChart
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Margin="0,12,0,0"
                                Points="{x:Bind ViewModel.TimelinePoints, Mode=OneWay}"
                                SeriesBrush="{ThemeResource ChartSeriesBrush}"
                                GridBrush="{ThemeResource ChartGridBrush}"
                                BaselineBrush="{ThemeResource ChartBaselineBrush}"
                                SurfaceBrush="{ThemeResource ChartSurfaceBrush}"
                                HoverBrush="{ThemeResource ChartHoverBrush}"
                                AxisLabelBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind game:GameFormat.ChartVisible(ViewModel.HasTimeline, TimelineTableToggle.IsChecked), Mode=OneWay}"
                                x:Uid="Game_TimelineChart" />
                            <ScrollViewer
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Margin="0,12,0,0"
                                Visibility="{x:Bind game:GameFormat.TableVisible(ViewModel.HasTimeline, TimelineTableToggle.IsChecked), Mode=OneWay}">
                                <ItemsRepeater
                                    ItemsSource="{x:Bind ViewModel.TimelinePoints, Mode=OneWay}"
                                    Margin="0,0,12,0"
                                    x:Uid="Game_TimelineTable">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="charts:ChartPoint">
                                            <Grid Padding="0,3" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Description}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind ValueText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                            <StackPanel
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.HasNoTimeline, Mode=OneWay}">
                                <FontIcon Glyph="&#xE81C;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.TimelineEmptyText, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
