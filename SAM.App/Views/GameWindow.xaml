<Window
    x:Class="SAM.App.Views.GameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SAM.App.Controls"
    xmlns:game="using:SAM.App.Views.Game"
    xmlns:vm="using:SAM.App.ViewModels">

    <!-- Hidden: otherwise WinUI shows the window-wide shortcuts (Ctrl+F etc.) as a tooltip
         on everything inside this grid. -->
    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            </Style>
        </Grid.Resources>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnCommitAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnReloadAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (content is extended into it). -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/SAM.ico" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis">
                <Run Text="{x:Bind ViewModel.GameName}" />
                <Run Text="  ·  Steam Achievement Manager" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1" Padding="24,4,24,0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header card. -->
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="246" Height="115" CornerRadius="6">
                        <controls:Skeleton
                            CornerRadius="6"
                            Visibility="{x:Bind game:GameFormat.Collapsed(ViewModel.IsHeaderImageLoaded), Mode=OneWay}" />
                        <Border
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind ViewModel.IsHeaderImageMissing, Mode=OneWay}">
                            <FontIcon Glyph="&#xE7FC;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Border>
                        <Image
                            Source="{x:Bind ViewModel.HeaderImage, Mode=OneWay}"
                            Stretch="UniformToFill"
                            Opacity="{x:Bind game:GameFormat.Opacity(ViewModel.IsHeaderImageLoaded), Mode=OneWay}"
                            AutomationProperties.Name="Game header image">
                            <Image.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.4" />
                            </Image.OpacityTransition>
                        </Image>
                        <Rectangle IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0.45" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#59000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock
                            Text="{x:Bind ViewModel.GameName}"
                            Style="{StaticResource TitleTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="2"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{x:Bind ViewModel.AppIdText}"
                            Style="{StaticResource CaptionSecondaryStyle}"
                            IsTextSelectionEnabled="True" />
                        <TextBlock
                            Text="{x:Bind ViewModel.PlaytimeText, Mode=OneWay}"
                            Style="{StaticResource CaptionSecondaryStyle}"
                            Visibility="{x:Bind ViewModel.HasPlaytime, Mode=OneWay}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            Margin="0,4,0,0"
                            Visibility="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                            <FontIcon
                                Glyph="&#xE70F;"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Visibility="{x:Bind ViewModel.HasPending, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.PendingText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Completion. -->
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="16"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                            <controls:Skeleton Width="72" Height="72" CornerRadius="36" />
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <controls:Skeleton Width="150" Height="24" />
                                <controls:Skeleton Width="110" Height="12" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="16"
                            Visibility="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                            <Grid Width="72" Height="72">
                                <ProgressRing
                                    Width="72"
                                    Height="72"
                                    IsIndeterminate="False"
                                    Maximum="100"
                                    Value="{x:Bind ViewModel.CompletionPercent, Mode=OneWay}"
                                    Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                                    AutomationProperties.Name="Achievement completion" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.CompletionPercentText, Mode=OneWay}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CompletionText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="achievements unlocked" Style="{StaticResource CaptionSecondaryStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Load errors and operation results. -->
            <StackPanel Grid.Row="1" Spacing="8">
                <InfoBar
                    Title="Couldn't load achievements"
                    Message="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                    Severity="Error"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasLoadError, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button Content="Retry" Command="{x:Bind ViewModel.ReloadCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}" />
            </StackPanel>

            <!-- Tabs and toolbar. -->
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged" VerticalAlignment="Center">
                    <SelectorBarItem x:Name="AchievementsTab" Text="Achievements" IsSelected="True">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE734;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="StatisticsTab" Text="Statistics">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE9D2;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>

                <CommandBar
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    DefaultLabelPosition="Right"
                    Background="Transparent"
                    IsOpen="False">
                    <AppBarElementContainer VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.UnlockAllCommand}"
                            ToolTipService.ToolTip="Unlock all shown achievements (protected ones are skipped)"
                            AutomationProperties.Name="Unlock all">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE785;" FontSize="16" />
                                <TextBlock Text="Unlock all" />
                            </StackPanel>
                        </Button>
                    </AppBarElementContainer>
                    <AppBarElementContainer VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.LockAllCommand}"
                            ToolTipService.ToolTip="Lock all shown achievements (protected ones are skipped)"
                            AutomationProperties.Name="Lock all">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" />
                                <TextBlock Text="Lock all" />
                            </StackPanel>
                        </Button>
                    </AppBarElementContainer>
                    <AppBarButton
                        Label="Invert"
                        Command="{x:Bind ViewModel.InvertCommand}"
                        ToolTipService.ToolTip="Invert all shown achievements (protected ones are skipped)">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8AB;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        Icon="Refresh"
                        Label="Reload"
                        Click="OnReloadClick"
                        IsEnabled="{x:Bind game:GameFormat.Not(ViewModel.IsBusy), Mode=OneWay}"
                        ToolTipService.ToolTip="Reload from Steam (F5)" />
                    <AppBarSeparator />
                    <AppBarElementContainer VerticalAlignment="Center">
                        <Button
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.CommitCommand}"
                            ToolTipService.ToolTip="Write the pending changes to Steam (Ctrl+S)"
                            AutomationProperties.Name="Commit changes">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="16" />
                                <TextBlock Text="{x:Bind ViewModel.CommitLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </AppBarElementContainer>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton
                            Label="Reset all stats…"
                            Click="OnResetAllStats"
                            IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
                            ToolTipService.ToolTip="Reset every stat for this game, optionally achievements too">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Grid>

            <!-- Body. -->
            <Grid Grid.Row="3">
                <!-- Loading placeholder rows. -->
                <ItemsControl
                    ItemsSource="{x:Bind SkeletonRows}"
                    IsTabStop="False"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,4">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Skeleton Width="48" Height="48" CornerRadius="6" />
                                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                        <controls:Skeleton Width="220" Height="14" HorizontalAlignment="Left" />
                                        <controls:Skeleton Width="380" Height="12" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <controls:Skeleton Grid.Column="2" Width="40" Height="20" CornerRadius="10" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Achievements tab. -->
                <Grid
                    x:Name="AchievementsPanel"
                    RowSpacing="8"
                    Opacity="{x:Bind game:GameFormat.Opacity(ViewModel.IsLoaded), Mode=OneWay}">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.3" />
                    </Grid.OpacityTransition>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            PlaceholderText="Search achievements (Ctrl+F)"
                            QueryIcon="Find"
                            TextChanged="OnSearchTextChanged"
                            AutomationProperties.Name="Search achievements" />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="150"
                            SelectedIndex="{x:Bind ViewModel.StateFilterIndex, Mode=TwoWay}"
                            ToolTipService.ToolTip="Filter by state"
                            AutomationProperties.Name="State filter">
                            <ComboBoxItem Content="All achievements" />
                            <ComboBoxItem Content="Locked" />
                            <ComboBoxItem Content="Unlocked" />
                            <ComboBoxItem Content="Pending changes" />
                        </ComboBox>
                        <ComboBox
                            Grid.Column="2"
                            MinWidth="150"
                            SelectedIndex="{x:Bind ViewModel.RarityFilterIndex, Mode=TwoWay}"
                            ToolTipService.ToolTip="Filter by rarity"
                            AutomationProperties.Name="Rarity filter">
                            <ComboBoxItem Content="Any rarity" />
                            <ComboBoxItem Content="Common" />
                            <ComboBoxItem Content="Uncommon" />
                            <ComboBoxItem Content="Rare" />
                            <ComboBoxItem Content="Epic" />
                            <ComboBoxItem Content="Legendary" />
                        </ComboBox>
                        <ComboBox
                            Grid.Column="3"
                            MinWidth="200"
                            SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                            ToolTipService.ToolTip="Sort order"
                            AutomationProperties.Name="Sort order">
                            <ComboBoxItem Content="Sort: Default order" />
                            <ComboBoxItem Content="Sort: Name" />
                            <ComboBoxItem Content="Sort: Rarest first" />
                            <ComboBoxItem Content="Sort: Most common first" />
                            <ComboBoxItem Content="Sort: Newest unlock first" />
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            MinWidth="180"
                            SelectedIndex="{x:Bind ViewModel.DateFilterIndex, Mode=TwoWay}"
                            ToolTipService.ToolTip="Filter unlocked achievements by unlock date"
                            AutomationProperties.Name="Unlock date filter">
                            <ComboBoxItem Content="Unlocked: any time" />
                            <ComboBoxItem Content="Unlocked today" />
                            <ComboBoxItem Content="Unlocked in the past 7 days" />
                            <ComboBoxItem Content="Unlocked in the past 30 days" />
                            <ComboBoxItem Content="Unlocked this year" />
                            <ComboBoxItem Content="Unlocked in custom range…" />
                        </ComboBox>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsCustomDateRange, Mode=OneWay}">
                            <CalendarDatePicker
                                PlaceholderText="From"
                                Date="{x:Bind ViewModel.CustomFrom, Mode=TwoWay}"
                                AutomationProperties.Name="Unlocked from" />
                            <CalendarDatePicker
                                PlaceholderText="To"
                                Date="{x:Bind ViewModel.CustomTo, Mode=TwoWay}"
                                AutomationProperties.Name="Unlocked to" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.ShowingText, Mode=OneWay}"
                            Style="{StaticResource CaptionSecondaryStyle}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,24"
                        HorizontalAlignment="Center"
                        Text="No achievements match the current filters."
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.HasNoVisibleAchievements, Mode=OneWay}" />

                    <ListView
                        x:Name="AchievementList"
                        Grid.Row="2"
                        Margin="-4,0,-16,0"
                        Padding="0,0,12,16"
                        ItemsSource="{x:Bind ViewModel.VisibleAchievements}"
                        SelectionMode="None"
                        ContainerContentChanging="OnAchievementContainerContentChanging"
                        AutomationProperties.Name="Achievements">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AchievementViewModel">
                                <Border Style="{StaticResource CardStyle}" Padding="0,10,14,10">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Pending change marker. -->
                                        <Border
                                            Width="4"
                                            Margin="0,-2"
                                            CornerRadius="0,2,2,0"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind IsPending, Mode=OneWay}" />

                                        <Grid Grid.Column="1" Width="48" Height="48" CornerRadius="6" VerticalAlignment="Top">
                                            <controls:Skeleton
                                                CornerRadius="6"
                                                Visibility="{x:Bind game:GameFormat.Collapsed(IsIconLoaded), Mode=OneWay}" />
                                            <Border
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind IsIconMissing, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE734;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Border>
                                            <Image
                                                Source="{x:Bind IconSource, Mode=OneWay}"
                                                Stretch="UniformToFill"
                                                Opacity="{x:Bind game:GameFormat.Opacity(IsIconLoaded), Mode=OneWay}">
                                                <Image.OpacityTransition>
                                                    <ScalarTransition Duration="0:0:0.3" />
                                                </Image.OpacityTransition>
                                            </Image>
                                        </Grid>

                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Text="{x:Bind Name}"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <FontIcon
                                                    Glyph="&#xE72E;"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind IsProtected}"
                                                    ToolTipService.ToolTip="Protected — only the game's servers can change this"
                                                    AutomationProperties.Name="Protected" />
                                                <Border
                                                    Padding="6,1"
                                                    CornerRadius="8"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{x:Bind IsPending, Mode=OneWay}">
                                                    <TextBlock
                                                        Text="{x:Bind PendingText, Mode=OneWay}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock
                                                Text="{x:Bind DisplayDescription, Mode=OneWay}"
                                                Style="{StaticResource BodyTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap"
                                                PointerEntered="OnDescriptionPointerEntered"
                                                PointerExited="OnDescriptionPointerExited"
                                                Tapped="OnDescriptionTapped" />
                                            <TextBlock
                                                Text="{x:Bind UnlockTimeText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Visibility="{x:Bind HasUnlockTimeText}" />
                                        </StackPanel>

                                        <!-- Rarity. -->
                                        <Grid Grid.Column="3" MinWidth="110" VerticalAlignment="Center">
                                            <StackPanel
                                                Spacing="6"
                                                HorizontalAlignment="Right"
                                                Visibility="{x:Bind IsRarityLoading, Mode=OneWay}">
                                                <controls:Skeleton Width="70" Height="18" CornerRadius="9" HorizontalAlignment="Right" />
                                                <controls:Skeleton Width="90" Height="10" HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <StackPanel
                                                Spacing="4"
                                                HorizontalAlignment="Right"
                                                Visibility="{x:Bind HasRarity, Mode=OneWay}">
                                                <Border
                                                    HorizontalAlignment="Right"
                                                    Padding="8,2"
                                                    CornerRadius="9"
                                                    Background="{x:Bind game:GameFormat.RarityBrush(Rarity), Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind RarityTierText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Text="{x:Bind RarityText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- The tooltip sits on a wrapper because disabled controls don't show one. -->
                                        <Border
                                            Grid.Column="4"
                                            Background="Transparent"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind game:GameFormat.ProtectedTooltip(IsProtected)}">
                                            <ToggleSwitch
                                                MinWidth="0"
                                                OnContent="Unlocked"
                                                OffContent="Locked"
                                                IsOn="{x:Bind IsChecked, Mode=TwoWay}"
                                                IsEnabled="{x:Bind CanChange}"
                                                AutomationProperties.Name="{x:Bind Name}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Statistics tab. -->
                <Grid
                    x:Name="StatisticsPanel"
                    RowSpacing="8"
                    Visibility="Collapsed"
                    Opacity="{x:Bind game:GameFormat.Opacity(ViewModel.IsLoaded), Mode=OneWay}">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.3" />
                    </Grid.OpacityTransition>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <InfoBar
                        Title="Edit statistics with care"
                        Message="Changing stats can break your progress in the game or achievements that depend on them. Stat changes are committed together with achievement changes."
                        Severity="Warning"
                        IsClosable="False"
                        IsOpen="True" />

                    <ToggleSwitch
                        Grid.Row="1"
                        Header="Allow editing"
                        OnContent="I understand the risk — editing enabled"
                        OffContent="Editing disabled"
                        IsOn="{x:Bind ViewModel.IsStatEditingEnabled, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,24"
                        HorizontalAlignment="Center"
                        Text="This game has no statistics."
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.HasNoStats, Mode=OneWay}" />

                    <ListView
                        Grid.Row="2"
                        Margin="-4,0,-16,0"
                        Padding="0,0,12,16"
                        ItemsSource="{x:Bind ViewModel.Stats}"
                        SelectionMode="None"
                        AutomationProperties.Name="Statistics">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatViewModel">
                                <Border Style="{StaticResource CardStyle}" Padding="0,10,14,10">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="4"
                                            Margin="0,-2"
                                            CornerRadius="0,2,2,0"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind IsModified, Mode=OneWay}" />

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{x:Bind Id}"
                                                FontFamily="Consolas"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                IsTextSelectionEnabled="True" />
                                            <TextBlock
                                                Text="{x:Bind FlagsText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsReadOnly}">
                                                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind ProtectedText}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- "Used by": achievements that depend on this stat (filled in later). -->
                                            <StackPanel Margin="0,6,0,0" Spacing="2" Visibility="{x:Bind HasUsedBy, Mode=OneWay}">
                                                <TextBlock Text="Used by" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                                <ItemsControl ItemsSource="{x:Bind UsedBy}" IsTabStop="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:StatUsage">
                                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                                <Run Text="{x:Bind AchievementName}" />
                                                                <Run Text=" — target " />
                                                                <Run Text="{x:Bind TargetValue}" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                            <NumberBox
                                                Value="{x:Bind EditValue, Mode=TwoWay}"
                                                IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                SpinButtonPlacementMode="Compact"
                                                SmallChange="1"
                                                AutomationProperties.Name="{x:Bind DisplayName}" />
                                            <TextBlock
                                                Text="{x:Bind Error, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind HasError, Mode=OneWay}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="3"
                                            MinWidth="120"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{x:Bind OriginalValueText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Visibility="{x:Bind game:GameFormat.VisibleIfAny(IsModified, HasError), Mode=OneWay}" />
                                            <Button
                                                Command="{x:Bind ResetToOriginalCommand}"
                                                IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                Visibility="{x:Bind game:GameFormat.VisibleIfAny(IsModified, HasError), Mode=OneWay}"
                                                ToolTipService.ToolTip="Reset to the original value"
                                                AutomationProperties.Name="Reset to the original value">
                                                <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
