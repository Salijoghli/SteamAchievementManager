<ContentDialog
    x:Class="SAM.App.Views.Autopilot.PreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SAM.App.Controls"
    xmlns:game="using:SAM.App.Views.Game"
    xmlns:pages="using:SAM.App.ViewModels.Pages"
    x:Uid="Autopilot_PreviewDialog"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <Style x:Key="RowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- No wrapping: the Game header sits in a zero-width column when one game is shown. -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style x:Key="TileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="860" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="460" />
        </Grid.RowDefinitions>

        <!-- Intro and which game. -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="Autopilot_PreviewIntro"
                TextWrapping="Wrap"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox
                Grid.Column="1"
                MinWidth="240"
                MaxWidth="360"
                x:Uid="Autopilot_PreviewGame"
                ItemsSource="{x:Bind ViewModel.GameOptions}"
                SelectedIndex="{x:Bind ViewModel.SelectedGameIndex, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasGameChoice}" />
        </Grid>

        <!-- At a glance. The full sentence is the screen-reader name of the group. -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.IsTableVisible, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.TotalsText, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource TileStyle}">
                <StackPanel>
                    <TextBlock x:Uid="Autopilot_PreviewTileUnlocks" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.InRunCountText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource TileStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.AfterRunHint}">
                <StackPanel>
                    <TextBlock x:Uid="Autopilot_PreviewTileAfter" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.AfterRunCountText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource TileStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.SkippedReasonsText, Mode=OneWay}">
                <StackPanel>
                    <TextBlock x:Uid="Autopilot_PreviewTileSkipped" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SkippedCountText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource TileStyle}">
                <StackPanel>
                    <TextBlock x:Uid="Autopilot_PreviewTileFinish" Style="{StaticResource TileLabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.FinishText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="6">
            <InfoBar
                Severity="Warning"
                IsClosable="False"
                Message="{x:Bind ViewModel.Warnings, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasWarnings, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasWarnings, Mode=OneWay}" />
            <InfoBar
                Severity="Informational"
                IsClosable="False"
                Message="{x:Bind ViewModel.TruncatedText}"
                IsOpen="{x:Bind ViewModel.IsTruncated}"
                Visibility="{x:Bind ViewModel.IsTruncated}" />
        </StackPanel>

        <!-- The table, in a card. -->
        <Border
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundBrush}"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column headers (same columns as the rows). -->
                <Border
                    Padding="16,10"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{x:Bind ViewModel.IsTableVisible, Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind pages:AutopilotPreviewViewModel.GameColumnWidth(ViewModel.ShowGameColumn), Mode=OneWay}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Autopilot_ColumnGame" Style="{StaticResource HeaderStyle}" />
                        <TextBlock Grid.Column="1" x:Uid="Autopilot_ColumnAchievement" Style="{StaticResource HeaderStyle}" />
                        <TextBlock Grid.Column="2" x:Uid="Autopilot_ColumnRarity" Style="{StaticResource HeaderStyle}" />
                        <TextBlock Grid.Column="3" x:Uid="Autopilot_ColumnPlanned" Style="{StaticResource HeaderStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" x:Uid="Autopilot_ColumnEstimate" Style="{StaticResource HeaderStyle}" />
                    </Grid>
                </Border>

                <!-- Loading. -->
                <StackPanel Grid.Row="1" Spacing="14" Padding="16,14" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" x:Uid="Autopilot_PreviewLoading">
                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <controls:Skeleton Width="420" Height="14" HorizontalAlignment="Left" />
                    <controls:Skeleton Width="360" Height="14" HorizontalAlignment="Left" />
                    <controls:Skeleton Width="400" Height="14" HorizontalAlignment="Left" />
                    <controls:Skeleton Width="320" Height="14" HorizontalAlignment="Left" />
                    <controls:Skeleton Width="380" Height="14" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Couldn't plan. -->
                <StackPanel
                    Grid.Row="1"
                    Spacing="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                    <FontIcon Glyph="&#xE783;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                        TextWrapping="Wrap"
                        MaxWidth="480"
                        TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- No games. -->
                <TextBlock
                    Grid.Row="1"
                    x:Uid="Autopilot_PreviewNoGames"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind ViewModel.HasNoGames}" />

                <ListView
                    Grid.Row="1"
                    Padding="0,4"
                    x:Uid="Autopilot_PreviewTable"
                    SelectionMode="None"
                    ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                    ItemContainerStyle="{StaticResource RowStyle}"
                    Visibility="{x:Bind ViewModel.IsTableVisible, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="pages:AutopilotPreviewRow">
                            <Grid ColumnSpacing="16" Opacity="{x:Bind Opacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind GameWidth}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind GameName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border
                                        Padding="7,1,7,2"
                                        CornerRadius="9"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind game:GameFormat.RarityBrush(Rarity)}"
                                        Visibility="{x:Bind HasRarity}">
                                        <TextBlock Text="{x:Bind RarityTierText}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="{x:Bind PercentText}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind PlannedText}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{x:Bind pages:AutopilotPreviewRow.SecondaryIf(IsSkipped)}"
                                    ToolTipService.ToolTip="{x:Bind PlannedToolTip}" />
                                <TextBlock
                                    Grid.Column="4"
                                    Text="{x:Bind EstimateText}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{x:Bind pages:AutopilotPreviewRow.SecondaryIf(IsAfterRun)}"
                                    FontStyle="{x:Bind pages:AutopilotPreviewRow.ItalicIf(IsAfterRun)}"
                                    ToolTipService.ToolTip="{x:Bind EstimateToolTip}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
