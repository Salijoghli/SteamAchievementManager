<ContentDialog
    x:Class="SAM.App.Views.Autopilot.PreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SAM.App.Controls"
    xmlns:pages="using:SAM.App.ViewModels.Pages"
    x:Uid="Autopilot_PreviewDialog"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <Style x:Key="RowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="HeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="840" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="440" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="Autopilot_PreviewIntro"
                TextWrapping="Wrap"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox
                Grid.Column="1"
                MinWidth="240"
                MaxWidth="360"
                x:Uid="Autopilot_PreviewGame"
                ItemsSource="{x:Bind ViewModel.GameOptions}"
                SelectedIndex="{x:Bind ViewModel.SelectedGameIndex, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasGameChoice}" />
        </Grid>

        <TextBlock
            Grid.Row="1"
            Text="{x:Bind ViewModel.TotalsText, Mode=OneWay}"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsTableVisible, Mode=OneWay}" />

        <StackPanel Grid.Row="2" Spacing="6">
            <InfoBar
                Severity="Warning"
                IsClosable="False"
                Message="{x:Bind ViewModel.Warnings, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasWarnings, Mode=OneWay}" />
            <InfoBar
                Severity="Informational"
                IsClosable="False"
                Message="{x:Bind ViewModel.TruncatedText}"
                IsOpen="{x:Bind ViewModel.IsTruncated}" />
        </StackPanel>

        <!-- Column headers. -->
        <Grid Grid.Row="3" Padding="8,0" ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsTableVisible, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind pages:AutopilotPreviewViewModel.GameColumnWidth(ViewModel.ShowGameColumn), Mode=OneWay}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Autopilot_ColumnGame" Style="{StaticResource HeaderStyle}" />
            <TextBlock Grid.Column="1" x:Uid="Autopilot_ColumnAchievement" Style="{StaticResource HeaderStyle}" />
            <TextBlock Grid.Column="2" x:Uid="Autopilot_ColumnRarity" Style="{StaticResource HeaderStyle}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" x:Uid="Autopilot_ColumnPlanned" Style="{StaticResource HeaderStyle}" />
            <TextBlock Grid.Column="4" x:Uid="Autopilot_ColumnEstimate" Style="{StaticResource HeaderStyle}" />
        </Grid>

        <!-- Loading. -->
        <StackPanel Grid.Row="4" Spacing="10" Padding="8,6" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" x:Uid="Autopilot_PreviewLoading">
            <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <controls:Skeleton Width="420" Height="14" HorizontalAlignment="Left" />
            <controls:Skeleton Width="360" Height="14" HorizontalAlignment="Left" />
            <controls:Skeleton Width="400" Height="14" HorizontalAlignment="Left" />
            <controls:Skeleton Width="320" Height="14" HorizontalAlignment="Left" />
            <controls:Skeleton Width="380" Height="14" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Couldn't plan. -->
        <StackPanel
            Grid.Row="4"
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
            <FontIcon Glyph="&#xE783;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                TextWrapping="Wrap"
                MaxWidth="480"
                TextAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- No games. -->
        <TextBlock
            Grid.Row="4"
            x:Uid="Autopilot_PreviewNoGames"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="{x:Bind ViewModel.HasNoGames}" />

        <ListView
            Grid.Row="4"
            x:Uid="Autopilot_PreviewTable"
            SelectionMode="None"
            ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
            ItemContainerStyle="{StaticResource RowStyle}"
            Visibility="{x:Bind ViewModel.IsTableVisible, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="pages:AutopilotPreviewRow">
                    <Grid ColumnSpacing="12" Opacity="{x:Bind Opacity}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind GameWidth}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind GameName}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind PercentText}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{x:Bind PlannedText}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind PlannedText}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind EstimateText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
