<ContentDialog
    x:Class="SAM.App.Views.Autopilot.GamePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SAM.App.Controls"
    xmlns:vm="using:SAM.App.ViewModels"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
        <Style x:Key="PickerItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="640" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                x:Uid="Autopilot_PickerSearch"
                QueryIcon="Find"
                TextChanged="OnSearchTextChanged" />
            <!-- All games, installed, favorites, smart lists and collections. -->
            <ComboBox
                x:Name="FilterBox"
                x:Uid="Autopilot_PickerFilter"
                Grid.Column="1"
                MinWidth="170"
                MaxWidth="220"
                SelectionChanged="OnFilterSelectionChanged" />
            <CheckBox
                x:Name="LockedOnlyBox"
                x:Uid="Autopilot_PickerLockedOnly"
                Grid.Column="2"
                IsChecked="True"
                Click="OnFilterChanged" />
        </Grid>

        <Grid Grid.Row="1" Height="420">
            <!-- Loading skeleton (the library is still reading progress). -->
            <StackPanel x:Name="Skeletons" Spacing="10" Padding="8,6" x:Uid="Autopilot_PickerLoading">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <controls:Skeleton Width="64" Height="30" />
                    <controls:Skeleton Width="220" Height="14" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <controls:Skeleton Width="64" Height="30" />
                    <controls:Skeleton Width="180" Height="14" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <controls:Skeleton Width="64" Height="30" />
                    <controls:Skeleton Width="250" Height="14" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <controls:Skeleton Width="64" Height="30" />
                    <controls:Skeleton Width="200" Height="14" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <ListView
                x:Name="GameList"
                x:Uid="Autopilot_PickerList"
                SelectionMode="Multiple"
                ItemContainerStyle="{StaticResource PickerItemStyle}"
                SelectionChanged="OnSelectionChanged"
                ContainerContentChanging="OnContainerContentChanging"
                Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameCardViewModel">
                        <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="64" Height="30" CornerRadius="3">
                                <controls:Skeleton CornerRadius="0" Visibility="{x:Bind vm:LibraryFormat.VisibleIf(IsImagePending), Mode=OneWay}" />
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind vm:LibraryFormat.VisibleIf(ImageFailed), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="14" Foreground="White" />
                                </Border>
                                <Image Source="{x:Bind vm:LibraryFormat.Thumbnail(ImagePath), Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <Grid Grid.Column="2" ColumnSpacing="8" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Value="{x:Bind ProgressPercent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind ProgressCountText, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="EmptyText"
                x:Uid="Autopilot_PickerEmpty"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="CountText"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton x:Name="SelectAllButton" x:Uid="Autopilot_PickerSelectAll" Grid.Column="1" Padding="6,2" Click="OnSelectAllClick" />
        </Grid>
    </Grid>
</ContentDialog>
