<UserControl
    x:Class="SAM.App.Views.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:SAM.App.Controls.Charts"
    xmlns:controls="using:SAM.App.Controls"
    xmlns:game="using:SAM.App.Views.Game"
    xmlns:pages="using:SAM.App.ViewModels.Pages"
    xmlns:vm="using:SAM.App.ViewModels">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--
                Chart colours. One series, so one hue: the reference palette's blue, stepped per
                theme (validated ≥ 3:1 against the light and dark card surfaces). Gridlines are
                recessive hairlines; the baseline is one step firmer.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ChartSeriesBrush" Color="#3987E5" />
                    <SolidColorBrush x:Key="ChartGridBrush" Color="#17FFFFFF" />
                    <SolidColorBrush x:Key="ChartBaselineBrush" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="ChartSurfaceBrush" Color="#2C2C2C" />
                    <SolidColorBrush x:Key="ChartHoverBrush" Color="#0FFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ChartSeriesBrush" Color="#2A78D6" />
                    <SolidColorBrush x:Key="ChartGridBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="ChartBaselineBrush" Color="#40000000" />
                    <SolidColorBrush x:Key="ChartSurfaceBrush" Color="#FCFCFC" />
                    <SolidColorBrush x:Key="ChartHoverBrush" Color="#0A000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="TileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="TileValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="TileDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="PanelTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />

            <Style x:Key="PanelSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="TableToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Padding" Value="8,3,8,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <DataTemplate x:Key="TableRowTemplate" x:DataType="charts:ChartPoint">
                <Grid Padding="0,3" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ValueText}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="RankedRowTemplate" x:DataType="pages:RankedGameItem">
                <Grid ColumnSpacing="10" Padding="0,4" AutomationProperties.Name="{x:Bind AutomationName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="{x:Bind RankText}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        VerticalAlignment="Center" />
                    <HyperlinkButton
                        Grid.Column="1"
                        Padding="0"
                        Command="{x:Bind OpenCommand}"
                        ToolTipService.ToolTip="{x:Bind DetailText}"
                        AutomationProperties.Name="{x:Bind Name}">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    </HyperlinkButton>
                    <TextBlock Grid.Column="2" Text="{x:Bind ValueText}" VerticalAlignment="Center" />
                    <ProgressBar
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="0,4,0,0"
                        Maximum="100"
                        Value="{x:Bind BarPercent}"
                        IsTabStop="False"
                        AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" MaxWidth="2400" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="Column"
            Padding="24,4,24,24"
            RowSpacing="16"
            SizeChanged="OnColumnSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header. -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Uid="Stats_Intro"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <ProgressRing
                    Grid.Column="1"
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                    x:Uid="Pages_Refreshing" />
                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    x:Uid="Stats_RefreshButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock x:Uid="Pages_RefreshLabel" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Loading skeleton. -->
            <StackPanel
                Grid.Row="1"
                Spacing="16"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                x:Uid="Stats_Loading">
                <Grid x:Name="SkeletonTiles" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelStyle}" Height="104">
                        <StackPanel Spacing="10">
                            <controls:Skeleton Width="90" Height="12" HorizontalAlignment="Left" />
                            <controls:Skeleton Width="110" Height="26" HorizontalAlignment="Left" />
                            <controls:Skeleton Width="130" Height="12" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Height="104">
                        <StackPanel Spacing="10">
                            <controls:Skeleton Width="90" Height="12" HorizontalAlignment="Left" />
                            <controls:Skeleton Width="80" Height="26" HorizontalAlignment="Left" />
                            <controls:Skeleton Width="140" Height="12" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Height="104">
                        <StackPanel Spacing="10">
                            <controls:Skeleton Width="90" Height="12" HorizontalAlignment="Left" />
                            <controls:Skeleton Width="60" Height="26" HorizontalAlignment="Left" />
                            <controls:Skeleton Width="150" Height="12" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource PanelStyle}" Height="104">
                        <StackPanel Spacing="10">
                            <controls:Skeleton Width="90" Height="12" HorizontalAlignment="Left" />
                            <controls:Skeleton Width="100" Height="26" HorizontalAlignment="Left" />
                            <controls:Skeleton Width="120" Height="12" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource PanelStyle}" Height="104">
                        <StackPanel Spacing="10">
                            <controls:Skeleton Width="90" Height="12" HorizontalAlignment="Left" />
                            <controls:Skeleton Width="90" Height="26" HorizontalAlignment="Left" />
                            <controls:Skeleton Width="140" Height="12" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid x:Name="SkeletonCharts" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PanelStyle}" Height="300">
                        <StackPanel Spacing="10">
                            <controls:Skeleton Width="150" Height="16" HorizontalAlignment="Left" />
                            <controls:Skeleton Width="200" Height="12" HorizontalAlignment="Left" />
                            <controls:Skeleton Height="210" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Height="300">
                        <StackPanel Spacing="10">
                            <controls:Skeleton Width="170" Height="16" HorizontalAlignment="Left" />
                            <controls:Skeleton Width="220" Height="12" HorizontalAlignment="Left" />
                            <controls:Skeleton Height="210" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Nothing to summarize yet. -->
            <StackPanel
                Grid.Row="1"
                Margin="0,64,0,0"
                HorizontalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE9D2;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Uid="Stats_EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock
                    x:Uid="Stats_EmptyBody"
                    TextWrapping="Wrap"
                    MaxWidth="420"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Uid="Stats_EmptyRefresh" HorizontalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" />
            </StackPanel>

            <!-- Content. -->
            <StackPanel Grid.Row="1" Spacing="16" Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay}">
                <!-- KPI tiles. -->
                <Grid x:Name="Tiles" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelStyle}" x:Uid="Stats_TileUnlocked">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Stats_TileUnlockedLabel" Style="{StaticResource TileLabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.UnlockedText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.UnlockedDetail, Mode=OneWay}" Style="{StaticResource TileDetailStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}" x:Uid="Stats_TileCompletion">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Stats_TileCompletionLabel" Style="{StaticResource TileLabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CompletionText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CompletionDetail, Mode=OneWay}" Style="{StaticResource TileDetailStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelStyle}" x:Uid="Stats_TilePerfect">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Stats_TilePerfectLabel" Style="{StaticResource TileLabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PerfectText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PerfectDetail, Mode=OneWay}" Style="{StaticResource TileDetailStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource PanelStyle}" x:Uid="Stats_TilePlaytime">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="Stats_TilePlaytimeLabel" Style="{StaticResource TileLabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PlaytimeText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PlaytimeDetail, Mode=OneWay}" Style="{StaticResource TileDetailStyle}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="4"
                        Style="{StaticResource PanelStyle}"
                        ToolTipService.ToolTip="{x:Bind pages:StatsViewModel.HunterScoreExplanation}"
                        x:Uid="Stats_TileHunter"
                        AutomationProperties.HelpText="{x:Bind pages:StatsViewModel.HunterScoreExplanation}">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Uid="Stats_TileHunterLabel" Style="{StaticResource TileLabelStyle}" />
                                <FontIcon
                                    Glyph="&#xE946;"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.HunterScoreText, Mode=OneWay}" Style="{StaticResource TileValueStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.HunterScoreDetail, Mode=OneWay}" Style="{StaticResource TileDetailStyle}" />
                            <ProgressBar
                                Margin="0,2,0,0"
                                Maximum="100"
                                Value="{x:Bind ViewModel.HunterProgress, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsHunterCalculating, Mode=OneWay}"
                                x:Uid="Stats_HunterProgress" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Unlock history could not be read. -->
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasTimelineError, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Warning"
                    x:Uid="Stats_TimelineErrorBar"
                    Message="{x:Bind ViewModel.TimelineError, Mode=OneWay}" />

                <!-- Charts. -->
                <Grid x:Name="Charts" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="252" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="Stats_MonthlyTitle" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.MonthlySummary, Mode=OneWay}" Style="{StaticResource PanelSubtitleStyle}" />
                            <ToggleButton
                                x:Name="MonthlyTableToggle"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                x:Uid="Stats_MonthlyTableToggle"
                                Style="{StaticResource TableToggleStyle}"
                                IsEnabled="{x:Bind ViewModel.HasTimeline, Mode=OneWay}" />

                            <charts:ColumnChart
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,12,0,0"
                                Points="{x:Bind ViewModel.MonthlyPoints, Mode=OneWay}"
                                SeriesBrush="{ThemeResource ChartSeriesBrush}"
                                GridBrush="{ThemeResource ChartGridBrush}"
                                BaselineBrush="{ThemeResource ChartBaselineBrush}"
                                SurfaceBrush="{ThemeResource ChartSurfaceBrush}"
                                HoverBrush="{ThemeResource ChartHoverBrush}"
                                AxisLabelBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind pages:PageFormat.ChartVisible(ViewModel.HasTimeline, MonthlyTableToggle.IsChecked), Mode=OneWay}"
                                x:Uid="Stats_MonthlyChart" />
                            <ScrollViewer
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,12,0,0"
                                Visibility="{x:Bind pages:PageFormat.TableVisible(ViewModel.HasTimeline, MonthlyTableToggle.IsChecked), Mode=OneWay}">
                                <ItemsRepeater
                                    ItemsSource="{x:Bind ViewModel.MonthlyPoints, Mode=OneWay}"
                                    ItemTemplate="{StaticResource TableRowTemplate}"
                                    Margin="0,0,12,0"
                                    x:Uid="Stats_MonthlyTable" />
                            </ScrollViewer>
                            <TextBlock
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                x:Uid="Stats_NoChartData"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind vm:LibraryFormat.CollapsedIf(ViewModel.HasTimeline), Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="252" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="Stats_CumulativeTitle" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.CumulativeSummary, Mode=OneWay}" Style="{StaticResource PanelSubtitleStyle}" />
                            <ToggleButton
                                x:Name="CumulativeTableToggle"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                x:Uid="Stats_CumulativeTableToggle"
                                Style="{StaticResource TableToggleStyle}"
                                IsEnabled="{x:Bind ViewModel.HasTimeline, Mode=OneWay}" />

                            <charts:AreaChart
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,12,0,0"
                                Points="{x:Bind ViewModel.CumulativePoints, Mode=OneWay}"
                                SeriesBrush="{ThemeResource ChartSeriesBrush}"
                                GridBrush="{ThemeResource ChartGridBrush}"
                                BaselineBrush="{ThemeResource ChartBaselineBrush}"
                                SurfaceBrush="{ThemeResource ChartSurfaceBrush}"
                                HoverBrush="{ThemeResource ChartHoverBrush}"
                                AxisLabelBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                Visibility="{x:Bind pages:PageFormat.ChartVisible(ViewModel.HasTimeline, CumulativeTableToggle.IsChecked), Mode=OneWay}"
                                x:Uid="Stats_CumulativeChart" />
                            <ScrollViewer
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,12,0,0"
                                Visibility="{x:Bind pages:PageFormat.TableVisible(ViewModel.HasTimeline, CumulativeTableToggle.IsChecked), Mode=OneWay}">
                                <ItemsRepeater
                                    ItemsSource="{x:Bind ViewModel.CumulativePoints, Mode=OneWay}"
                                    ItemTemplate="{StaticResource TableRowTemplate}"
                                    Margin="0,0,12,0"
                                    x:Uid="Stats_CumulativeTable" />
                            </ScrollViewer>
                            <TextBlock
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                x:Uid="Stats_NoChartData"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind vm:LibraryFormat.CollapsedIf(ViewModel.HasTimeline), Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Lists. -->
                <Grid x:Name="Lists" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Rarest unlocks. -->
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Stats_RarestTitle" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock x:Uid="Stats_RarestSubtitle" Style="{StaticResource PanelSubtitleStyle}" />
                            <TextBlock
                                x:Uid="Stats_RarestFetching"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind ViewModel.IsFetchingRarest, Mode=OneWay}" />
                            <TextBlock
                                x:Uid="Stats_RarestEmpty"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind ViewModel.IsRarestEmpty, Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.RarestUnlocks}" x:Uid="Stats_RarestList">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="pages:UnlockItemViewModel">
                                        <Grid
                                            ColumnSpacing="10"
                                            Padding="0,4"
                                            AutomationProperties.Name="{x:Bind Name}"
                                            AutomationProperties.HelpText="{x:Bind RarityToolTip, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <Grid>
                                                    <FontIcon
                                                        Glyph="&#xE734;"
                                                        FontSize="16"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Visibility="{x:Bind IsIconMissing, Mode=OneWay}" />
                                                    <Image Source="{x:Bind IconSource, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Description}" />
                                                <HyperlinkButton
                                                    Padding="0"
                                                    FontSize="12"
                                                    Command="{x:Bind OpenGameCommand}"
                                                    ToolTipService.ToolTip="{x:Bind OpenGameLabel}"
                                                    AutomationProperties.Name="{x:Bind OpenGameLabel}">
                                                    <TextBlock Text="{x:Bind GameName}" TextTrimming="CharacterEllipsis" />
                                                </HyperlinkButton>
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Spacing="2"
                                                ToolTipService.ToolTip="{x:Bind RarityToolTip, Mode=OneWay}">
                                                <Border
                                                    Padding="6,1,6,2"
                                                    CornerRadius="8"
                                                    HorizontalAlignment="Right"
                                                    Background="{x:Bind game:GameFormat.RarityBrush(Rarity), Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind RarityTierText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                                <TextBlock
                                                    Text="{x:Bind RarityText, Mode=OneWay}"
                                                    FontSize="12"
                                                    HorizontalAlignment="Right"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- Top games by completion. -->
                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Stats_TopCompletionTitle" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock x:Uid="Stats_TopCompletionSubtitle" Style="{StaticResource PanelSubtitleStyle}" />
                            <TextBlock
                                x:Uid="Stats_TopCompletionEmpty"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind pages:PageFormat.VisibleIfEmpty(ViewModel.TopCompletion), Mode=OneWay}" />
                            <ItemsRepeater
                                ItemsSource="{x:Bind ViewModel.TopCompletion, Mode=OneWay}"
                                ItemTemplate="{StaticResource RankedRowTemplate}"
                                x:Uid="Stats_TopCompletionList" />
                        </StackPanel>
                    </Border>

                    <!-- Top games by playtime. -->
                    <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Stats_TopPlaytimeTitle" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock x:Uid="Stats_TopPlaytimeSubtitle" Style="{StaticResource PanelSubtitleStyle}" />
                            <TextBlock
                                x:Uid="Stats_TopPlaytimeEmpty"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind pages:PageFormat.VisibleIfEmpty(ViewModel.TopPlaytime), Mode=OneWay}" />
                            <ItemsRepeater
                                ItemsSource="{x:Bind ViewModel.TopPlaytime, Mode=OneWay}"
                                ItemTemplate="{StaticResource RankedRowTemplate}"
                                x:Uid="Stats_TopPlaytimeList" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
