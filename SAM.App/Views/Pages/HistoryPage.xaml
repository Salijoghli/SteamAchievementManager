<UserControl
    x:Class="SAM.App.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SAM.App.Controls"
    xmlns:pages="using:SAM.App.ViewModels.Pages">

    <UserControl.Resources>
        <Style x:Key="RowContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="2400" Padding="24,4,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filters. -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Uid="History_Search"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                Grid.Column="1"
                MinWidth="150"
                ItemsSource="{x:Bind ViewModel.SourceOptions}"
                SelectedIndex="{x:Bind ViewModel.SourceIndex, Mode=TwoWay}"
                x:Uid="History_Source" />
            <TextBlock
                Grid.Column="2"
                Margin="8,0,0,0"
                Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
            <ProgressRing
                Grid.Column="3"
                Width="16"
                Height="16"
                IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                x:Uid="Pages_Refreshing" />
            <Button
                Grid.Column="4"
                Command="{x:Bind ViewModel.RefreshCommand}"
                x:Uid="History_RefreshButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock x:Uid="Pages_RefreshLabel" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Where backups live. -->
        <Grid
            Grid.Row="1"
            Padding="12,8"
            ColumnSpacing="10"
            CornerRadius="{StaticResource CardCornerRadius}"
            Background="{ThemeResource CardBackgroundBrush}"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                TextWrapping="Wrap"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                x:Uid="History_BackupsHint" />
        </Grid>

        <!-- Loading skeleton. -->
        <StackPanel
            Grid.Row="2"
            Spacing="4"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            x:Uid="History_Loading">
            <Border Padding="16,12" CornerRadius="{StaticResource CardCornerRadius}" Background="{ThemeResource CardBackgroundBrush}">
                <StackPanel Spacing="6">
                    <controls:Skeleton Width="200" Height="14" HorizontalAlignment="Left" />
                    <controls:Skeleton Width="300" Height="12" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border Padding="16,12" CornerRadius="{StaticResource CardCornerRadius}" Background="{ThemeResource CardBackgroundBrush}">
                <StackPanel Spacing="6">
                    <controls:Skeleton Width="160" Height="14" HorizontalAlignment="Left" />
                    <controls:Skeleton Width="260" Height="12" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border Padding="16,12" CornerRadius="{StaticResource CardCornerRadius}" Background="{ThemeResource CardBackgroundBrush}">
                <StackPanel Spacing="6">
                    <controls:Skeleton Width="240" Height="14" HorizontalAlignment="Left" />
                    <controls:Skeleton Width="220" Height="12" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- The log. -->
        <ListView
            Grid.Row="2"
            Padding="0,0,0,24"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            SelectionMode="None"
            ItemContainerStyle="{StaticResource RowContainerStyle}"
            Visibility="{x:Bind ViewModel.IsListVisible, Mode=OneWay}"
            x:Uid="History_List">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="pages:HistoryItemViewModel">
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                        AutomationProperties.Name="{x:Bind AutomationName}">
                        <Expander.Header>
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind StatusText}" AutomationProperties.Name="{x:Bind StatusText}">
                                    <FontIcon
                                        Glyph="&#xE73E;"
                                        FontSize="16"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Visibility="{x:Bind Succeeded}" />
                                    <FontIcon
                                        Glyph="&#xEA39;"
                                        FontSize="16"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Visibility="{x:Bind Failed}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <HyperlinkButton
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        Command="{x:Bind OpenGameCommand}"
                                        ToolTipService.ToolTip="{x:Bind OpenGameLabel}"
                                        AutomationProperties.Name="{x:Bind OpenGameLabel}">
                                        <TextBlock Text="{x:Bind GameName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </HyperlinkButton>
                                    <TextBlock Text="{x:Bind Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Message}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Message}"
                                        Visibility="{x:Bind HasFailureMessage}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="2"
                                    Padding="8,2,8,3"
                                    CornerRadius="10"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    x:Uid="History_SourceBadge">
                                    <TextBlock Text="{x:Bind SourceText}" FontSize="12" />
                                </Border>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="96" ToolTipService.ToolTip="{x:Bind FullTimeText}">
                                    <TextBlock Text="{x:Bind DateText}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind TimeText}"
                                        HorizontalAlignment="Right"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>

                        <StackPanel Spacing="12">
                            <TextBlock
                                x:Uid="History_NoChangesRecorded"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind pages:PageFormat.Collapsed(HasChanges)}" />
                            <ItemsControl ItemsSource="{x:Bind Details, Mode=OneWay}" IsTabStop="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:HistoryDetailGroup">
                                        <StackPanel Spacing="2" Margin="0,0,0,10">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl ItemsSource="{x:Bind Lines}" IsTabStop="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Spacing="2" Visibility="{x:Bind HasFailureMessage}">
                                <TextBlock x:Uid="History_ErrorLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind Message}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Couldn't read the log. -->
        <StackPanel
            Grid.Row="2"
            Margin="0,48,0,0"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
            <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Uid="History_ErrorTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                TextWrapping="Wrap"
                MaxWidth="420"
                TextAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Uid="Pages_TryAgain" HorizontalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" />
        </StackPanel>

        <!-- Nothing committed yet. -->
        <StackPanel
            Grid.Row="2"
            Margin="0,48,0,0"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE81C;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Uid="History_EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                x:Uid="History_EmptyBody"
                TextWrapping="Wrap"
                MaxWidth="440"
                TextAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Filters hide everything. -->
        <StackPanel
            Grid.Row="2"
            Margin="0,48,0,0"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsNoMatches, Mode=OneWay}">
            <FontIcon Glyph="&#xE721;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Uid="History_NoMatchesTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock
                x:Uid="History_NoMatchesBody"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
            <Button
                x:Uid="Pages_ClearFilters"
                HorizontalAlignment="Center"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.ClearFiltersCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
