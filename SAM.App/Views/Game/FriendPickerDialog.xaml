<ContentDialog
    x:Class="SAM.App.Views.Game.FriendPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SAM.App.ViewModels"
    x:Uid="Game_FriendPicker"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    Style="{StaticResource DefaultContentDialogStyle}">

    <Grid Width="420" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <AutoSuggestBox
            x:Name="SearchBox"
            x:Uid="Game_FriendSearch"
            QueryIcon="Find"
            TextChanged="OnSearchTextChanged" />

        <Grid Grid.Row="1" MinHeight="200">
            <!-- No friends, no matches, or Steam couldn't be asked. -->
            <StackPanel
                x:Name="EmptyState"
                Margin="0,32"
                Spacing="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE716;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    x:Name="EmptyText"
                    MaxWidth="360"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ListView
                x:Name="FriendList"
                MaxHeight="380"
                ItemsSource="{x:Bind Items}"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="OnFriendClick"
                SelectionChanged="OnSelectionChanged"
                ContainerContentChanging="OnContainerContentChanging"
                x:Uid="Game_FriendList">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FriendItemViewModel">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="36" Height="36">
                                <PersonPicture
                                    Width="36"
                                    Height="36"
                                    DisplayName="{x:Bind Name}"
                                    ProfilePicture="{x:Bind Avatar, Mode=OneWay}"
                                    AutomationProperties.AccessibilityView="Raw" />
                                <!-- Presence dot: online friends are listed first. -->
                                <Ellipse
                                    Width="11"
                                    Height="11"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                    Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    StrokeThickness="2"
                                    Visibility="{x:Bind IsOnline}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind StatusText}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</ContentDialog>
